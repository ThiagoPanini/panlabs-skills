&quot;id&quot;:&quot;dado-b&quot;,&quot;tipo&quot;:&quot;subnet&quot;,&quot;rotulo&quot;:&quot;acme-dado-1b&quot;,&quot;acesso&quot;:&quot;privada&quot;,&quot;az&quot;:&quot;us-east-1b&quot;,&quot;dentro&quot;:&quot;vpc&quot;},{&quot;id&quot;:&quot;ec2-a&quot;,&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;ec2&quot;,&quot;rotulo&quot;:&quot;EC2&quot;,&quot;dentro&quot;:&quot;app-a&quot;},{&quot;id&quot;:&quot;ec2-b&quot;,&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;ec2&quot;,&quot;rotulo&quot;:&quot;EC2&quot;,&quot;dentro&quot;:&quot;app-b&quot;},{&quot;id&quot;:&quot;rds-a&quot;,&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;rds&quot;,&quot;rotulo&quot;:&quot;RDS primária&quot;,&quot;dentro&quot;:&quot;dado-a&quot;},{&quot;id&quot;:&quot;rds-b&quot;,&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;rds&quot;,&quot;rotulo&quot;:&quot;RDS standby&quot;,&quot;dentro&quot;:&quot;dado-b&quot;},{&quot;id&quot;:&quot;tgw-ctx-2&quot;,&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;transit gateway&quot;,&quot;rotulo&quot;:&quot;acme-tgw-1a (attach)&quot;,&quot;dentro&quot;:&quot;pub-a&quot;},{&quot;id&quot;:&quot;tgw-ctx-5&quot;,&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;transit gateway&quot;,&quot;rotulo&quot;:&quot;acme-tgw-1b (attach)&quot;,&quot;dentro&quot;:&quot;pub-b&quot;}],&quot;faixas&quot;:[{&quot;id&quot;:&quot;asg&quot;,&quot;tipo&quot;:&quot;auto-scaling&quot;,&quot;rotulo&quot;:&quot;Auto Scaling group&quot;,&quot;membros&quot;:[&quot;ec2-a&quot;,&quot;ec2-b&quot;]}],&quot;notas&quot;:[{&quot;texto&quot;:&quot;As colunas de zona não estão no modelo. O motor derivou que a arquitetura afirma redundância zonal (mesmo papel de subnet em ≥2 AZs) e desenhou as faixas — regra do #19, não escolha do agente.&quot;,&quot;origem&quot;:&quot;legenda&quot;},{&quot;id&quot;:&quot;nota-ctx-1&quot;,&quot;texto&quot;:&quot;\&quot;NAT gateway\&quot; removido — proibido pelo context pack.&quot;,&quot;origem&quot;:&quot;premissa&quot;,&quot;sobre&quot;:&quot;pub-a&quot;},{&quot;id&quot;:&quot;nota-ctx-3&quot;,&quot;texto&quot;:&quot;Virou subnet privada + attachment ao Transit Gateway (context pack).&quot;,&quot;origem&quot;:&quot;premissa&quot;,&quot;sobre&quot;:&quot;pub-a&quot;},{&quot;id&quot;:&quot;nota-ctx-4&quot;,&quot;texto&quot;:&quot;\&quot;NAT gateway\&quot; removido — proibido pelo context pack.&quot;,&quot;origem&quot;:&quot;premissa&quot;,&quot;sobre&quot;:&quot;pub-b&quot;},{&quot;id&quot;:&quot;nota-ctx-6&quot;,&quot;texto&quot;:&quot;Virou subnet privada + attachment ao Transit Gateway (context pack).&quot;,&quot;origem&quot;:&quot;premissa&quot;,&quot;sobre&quot;:&quot;pub-b&quot;},{&quot;id&quot;:&quot;nota-ctx-7&quot;,&quot;texto&quot;:&quot;Renomeado de \&quot;App subnet\&quot; — nomenclatura do context pack.&quot;,&quot;origem&quot;:&quot;premissa&quot;,&quot;sobre&quot;:&quot;app-a&quot;},{&quot;id&quot;:&quot;nota-ctx-8&quot;,&quot;texto&quot;:&quot;Renomeado de \&quot;App subnet\&quot; — nomenclatura do context pack.&quot;,&quot;origem&quot;:&quot;premissa&quot;,&quot;sobre&quot;:&quot;app-b&quot;},{&quot;id&quot;:&quot;nota-ctx-9&quot;,&quot;texto&quot;:&quot;Renomeado de \&quot;Data subnet\&quot; — nomenclatura do context pack.&quot;,&quot;origem&quot;:&quot;premissa&quot;,&quot;sobre&quot;:&quot;dado-a&quot;},{&quot;id&quot;:&quot;nota-ctx-10&quot;,&quot;texto&quot;:&quot;Renomeado de \&quot;Data subnet\&quot; — nomenclatura do context pack.&quot;,&quot;origem&quot;:&quot;premissa&quot;,&quot;sobre&quot;:&quot;dado-b&quot;},{&quot;id&quot;:&quot;nota-ctx-11&quot;,&quot;texto&quot;:&quot;Renomeado de \&quot;VPC de produção · 10.0.0.0/16\&quot; — nomenclatura do context pack.&quot;,&quot;origem&quot;:&quot;premissa&quot;,&quot;sobre&quot;:&quot;vpc&quot;},{&quot;id&quot;:&quot;nota-ctx-12&quot;,&quot;texto&quot;:&quot;Falta CMK do cliente para o dado em repouso — confirmar antes de aprovar.&quot;,&quot;origem&quot;:&quot;premissa&quot;,&quot;sobre&quot;:&quot;dado-a&quot;},{&quot;id&quot;:&quot;nota-ctx-13&quot;,&quot;texto&quot;:&quot;Falta CMK do cliente para o dado em repouso — confirmar antes de aprovar.&quot;,&quot;origem&quot;:&quot;premissa&quot;,&quot;sobre&quot;:&quot;dado-b&quot;},{&quot;id&quot;:&quot;nota-ctx-14&quot;,&quot;texto&quot;:&quot;Serviços em subnet privada podem precisar de VPC endpoint — confirmar integrações antes de aprovar.&quot;,&quot;origem&quot;:&quot;premissa&quot;}],&quot;dossie&quot;:{&quot;contextPack&quot;:[{&quot;sobre&quot;:&quot;pub-a&quot;,&quot;resumo&quot;:&quot;\&quot;NAT gateway\&quot; removido — proibido pelo context pack.&quot;,&quot;premissa&quot;:&quot;catálogo.proibidos inclui \&quot;nat gateway\&quot;&quot;},{&quot;sobre&quot;:&quot;pub-a&quot;,&quot;resumo&quot;:&quot;Virou subnet privada + attachment ao Transit Gateway (context pack).&quot;,&quot;premissa&quot;:&quot;Toda subnet de conta de aplicação é privada. Não existe subnet pública em conta de aplicação — sem exceção de workload. | Todo egress, de qualquer natureza (internet, on-prem, outra VPC), atravessa a conta de trânsito via Transit Gateway. Uma VPC de aplicação nunca tem rota direta para um Internet Gateway.&quot;},{&quot;sobre&quot;:&quot;pub-b&quot;,&quot;resumo&quot;:&quot;\&quot;NAT gateway\&quot; removido — proibido pelo context pack.&quot;,&quot;premissa&quot;:&quot;catálogo.proibidos inclui \&quot;nat gateway\&quot;&quot;},{&quot;sobre&quot;:&quot;pub-b&quot;,&quot;resumo&quot;:&quot;Virou subnet privada + attachment ao Transit Gateway (context pack).&quot;,&quot;premissa&quot;:&quot;Toda subnet de conta de aplicação é privada. Não existe subnet pública em conta de aplicação — sem exceção de workload. | Todo egress, de qualquer natureza (internet, on-prem, outra VPC), atravessa a conta de trânsito via Transit Gateway. Uma VPC de aplicação nunca tem rota direta para um Internet Gateway.&quot;},{&quot;sobre&quot;:&quot;app-a&quot;,&quot;resumo&quot;:&quot;Renomeado de \&quot;App subnet\&quot; — nomenclatura do context pack.&quot;,&quot;premissa&quot;:&quot;Recurso: `acme-&lt;camada&gt;-&lt;sufixo&gt;`, minúsculo, kebab-case. Exemplos: `acme-app-1a`, `acme-tgw-hub`.&quot;},{&quot;sobre&quot;:&quot;app-b&quot;,&quot;resumo&quot;:&quot;Renomeado de \&quot;App subnet\&quot; — nomenclatura do context pack.&quot;,&quot;premissa&quot;:&quot;Recurso: `acme-&lt;camada&gt;-&lt;sufixo&gt;`, minúsculo, kebab-case. Exemplos: `acme-app-1a`, `acme-tgw-hub`.&quot;},{&quot;sobre&quot;:&quot;dado-a&quot;,&quot;resumo&quot;:&quot;Renomeado de \&quot;Data subnet\&quot; — nomenclatura do context pack.&quot;,&quot;premissa&quot;:&quot;Recurso: `acme-&lt;camada&gt;-&lt;sufixo&gt;`, minúsculo, kebab-case. Exemplos: `acme-app-1a`, `acme-tgw-hub`.&quot;},{&quot;sobre&quot;:&quot;dado-b&quot;,&quot;resumo&quot;:&quot;Renomeado de \&quot;Data subnet\&quot; — nomenclatura do context pack.&quot;,&quot;premissa&quot;:&quot;Recurso: `acme-&lt;camada&gt;-&lt;sufixo&gt;`, minúsculo, kebab-case. Exemplos: `acme-app-1a`, `acme-tgw-hub`.&quot;},{&quot;sobre&quot;:&quot;vpc&quot;,&quot;resumo&quot;:&quot;Renomeado de \&quot;VPC de produção · 10.0.0.0/16\&quot; — nomenclatura do context pack.&quot;,&quot;premissa&quot;:&quot;VPC: `acme-vpc-&lt;propósito&gt;`. Exemplos: `acme-vpc-workload`, `acme-vpc-transito`.&quot;},{&quot;sobre&quot;:&quot;dado-a&quot;,&quot;resumo&quot;:&quot;Falta CMK do cliente para o dado em repouso — confirmar antes de aprovar.&quot;,&quot;premissa&quot;:&quot;Toda subnet com dado em repouso referencia uma chave gerenciada pelo cliente (KMS CMK) — nunca a chave gerenciada pela AWS (`aws/service`).&quot;},{&quot;sobre&quot;:&quot;dado-b&quot;,&quot;resumo&quot;:&quot;Falta CMK do cliente para o dado em repouso — confirmar antes de aprovar.&quot;,&quot;premissa&quot;:&quot;Toda subnet com dado em repouso referencia uma chave gerenciada pelo cliente (KMS CMK) — nunca a chave gerenciada pela AWS (`aws/service`).&quot;},{&quot;sobre&quot;:null,&quot;resumo&quot;:&quot;Serviços em subnet privada podem precisar de VPC endpoint — confirmar integrações antes de aprovar.&quot;,&quot;premissa&quot;:&quot;Todo serviço que fala com uma API AWS a partir de subnet privada usa VPC endpoint — ver \&quot;Catálogo de serviços\&quot; acima.&quot;}]}}">
          <mxCell style="text;html=1;" vertex="1" parent="1" visible="0">
            <mxGeometry x="0" y="0" width="1" height="1" as="geometry"/>
          </mxCell>
        </object>
