do&quot;:&quot;devolvido&quot;,&quot;nota&quot;:&quot;voltou na fase técnica como sugestão inferida contra a capacidade, e foi confirmado (#15 §5).&quot;},{&quot;nome&quot;:&quot;S3&quot;,&quot;capacidade&quot;:&quot;reter-objeto&quot;,&quot;estado&quot;:&quot;devolvido&quot;,&quot;nota&quot;:&quot;voltou e foi confirmado, nas duas zonas do lago.&quot;}],&quot;candidatas&quot;:[{&quot;id&quot;:&quot;cand-a&quot;,&quot;nome&quot;:&quot;Só chegou, já processou&quot;,&quot;estado&quot;:&quot;escolhida&quot;,&quot;tupla&quot;:[&quot;gerenciado-sem-compute&quot;,&quot;evento&quot;,&quot;data-lake&quot;,&quot;privado&quot;,&quot;multi-fronteira&quot;],&quot;compra&quot;:&quot;painel fresco minutos após a loja enviar; zero runtime seu.&quot;,&quot;paga&quot;:&quot;custo por evento imprevisível em dia de pico; depurar fluxo assíncrono é chato.&quot;,&quot;escolhaSe&quot;:&quot;\&quot;painel velho\&quot; é a dor principal da diretoria.&quot;,&quot;erradaSe&quot;:&quot;o volume por loja crescer 10× — aí o custo por evento passa o de lote.&quot;,&quot;porque&quot;:&quot;a dor declarada é frescor, e a separação de fronteiras da ata sobrevive.&quot;},{&quot;id&quot;:&quot;cand-b&quot;,&quot;nome&quot;:&quot;Micro-lote de 15 minutos&quot;,&quot;estado&quot;:&quot;descartada&quot;,&quot;difereEm&quot;:[&quot;E2&quot;],&quot;tupla&quot;:[&quot;gerenciado-sem-compute&quot;,&quot;lote-agendado&quot;,&quot;data-lake&quot;,&quot;privado&quot;,&quot;multi-fronteira&quot;],&quot;compra&quot;:&quot;custo previsível, reprocessamento trivial, uma janela para consertar arquivo torto.&quot;,&quot;paga&quot;:&quot;até 15 min de atraso — a reclamação da diretoria volta menor, não some.&quot;,&quot;escolhaSe&quot;:&quot;auditoria e reprocessamento pesam mais que frescor.&quot;,&quot;erradaSe&quot;:&quot;alguém prometeu \&quot;tempo real\&quot; para a diretoria.&quot;,&quot;porque&quot;:&quot;descartada: o atraso residual não resolve a dor declarada. Fica em pé se o custo por evento estourar.&quo