      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t1" value="C · AZ em linhas, fluxo numerado só na zona de referência" style="text;html=1;fontSize=19;fontStyle=1;fontColor=#232F3E;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="34" width="1494" height="26" as="geometry"/></mxCell>
        <mxCell id="t2" value="A saída que o #6 mediu a AWS usando para multi-conta, aplicada a zona: a aresta que cruzaria fronteira simplesmente não é desenhada. O fluxo percorre uma zona; as outras são estrutura." style="text;html=1;fontSize=12;fontColor=#5A6C86;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1494" height="34" as="geometry"/></mxCell>
        <mxCell id="t3" value="&lt;b&gt;O que olhar:&lt;/b&gt; zero aresta cruzando zona. O leitor infere que 1b e 1c fazem o mesmo — a redundância é dita pela repetição, não pelo conector. É o mesmo movimento do diagrama multi-conta carro-chefe da AWS, que tem ZERO conectores." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#AAB7B8;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="746" width="1494" height="60" as="geometry"/></mxCell>
