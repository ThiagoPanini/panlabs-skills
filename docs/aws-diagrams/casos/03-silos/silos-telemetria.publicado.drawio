        <object id="panlabs-modelo" label="" panlabsEsquema="panlabs-aws-diagrams/publicado@1" panlabsVista="tecnica" panlabsSemantica="sha256:f59b2df358c2a8427fe66b0abb66db9ae0eb14907e6254f6ba3601e42158ed50" panlabsAparencia="sha256:56725444081895ecfcfea354d4850252d96e596b4869278166b3ef76ef0ebe2c" panlabsMotor="panlabs-aws-diagrams/motor@1" panlabsRetomavel="nao" panlabsPorque="copia publicada: a deliberacao da sessao (candidatas descartadas, motivo das recusas, estacionamento, quem aprovou) foi podada. Retome a partir do arquivo de trabalho." panlabsSessao="{&quot;esquema&quot;:&quot;panlabs-aws-diagrams/sessao@1&quot;,&quot;id&quot;:&quot;silos-telemetria&quot;,&quot;titulo&quot;:&quot;Cooperativa · telemetria de silos&quot;,&quot;estagio&quot;:&quot;tecnica&quot;,&quot;vistas&quot;:{&quot;logica&quot;:{&quot;genero&quot;:&quot;L2&quot;,&quot;titulo&quot;:&quot;Cooperativa · telemetria de silos · vista lógica&quot;,&quot;subtitulo&quot;:&quot;Capacidades e fronteiras de responsabilidade — zero nome de serviço AWS. Esta é a vista que o conselho aprovou.&quot;},&quot;tecnica&quot;:{&quot;genero&quot;:&quot;T3&quot;,&quot;titulo&quot;:&quot;Cooperativa · telemetria de silos · vista técnica&quot;,&quot;subtitulo&quot;:&quot;T3 event-driven · a MESMA vista aprovada, agora com serviços AWS e o leque assíncrono explícito.&quot;}},&quot;nos&quot;:[{&quot;id&quot;:&quot;silo&quot;,&quot;rotulo&quot;:&quot;Silos&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;ator&quot;,&quot;nota&quot;:&quot;1.200 silos, leitura a cada 5 min&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;ator&quot;,&quot;servico&quot;:&quot;users&quot;,&quot;rotulo&quot;:&quot;Silos&quot;}},{&quot;id&quot;:&quot;agronomo&quot;,&quot;rotulo&quot;:&quot;Agrônomos&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;ator&quot;,&quot;nota&quot;:&quot;18 técnicos de campo&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;ator&quot;,&quot;servico&quot;:&quot;users&quot;,&quot;rotulo&quot;:&quot;Agrônomos&quot;}},{&quot;id&quot;:&quot;cooperado&quot;,&quot;rotulo&quot;:&quot;Cooperados&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;ator&quot;,&quot;nota&quot;:&quot;2.400 produtores&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;ator&quot;,&quot;servico&quot;:&quot;users&quot;,&quot;rotulo&quot;:&quot;Cooperados&quot;}},{&quot;id&quot;:&quot;campo&quot;,&quot;rotulo&quot;:&quot;Campo&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;grupo&quot;,&quot;nota&quot;:&quot;dono: engenharia agrícola&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;grupo&quot;,&quot;rotulo&quot;:&quot;Campo&quot;},&quot;dentro&quot;:&quot;nuvem&quot;},{&quot;id&quot;:&quot;plataforma&quot;,&quot;rotulo&quot;:&quot;Plataforma&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;grupo&quot;,&quot;nota&quot;:&quot;dono: TI da cooperativa&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;grupo&quot;,&quot;rotulo&quot;:&quot;Plataforma&quot;},&quot;dentro&quot;:&quot;nuvem&quot;},{&quot;id&quot;:&quot;atendimento&quot;,&quot;rotulo&quot;:&quot;Atendimento&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;grupo&quot;,&quot;nota&quot;:&quot;dono: relacionamento&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;grupo&quot;,&quot;rotulo&quot;:&quot;Atendimento&quot;},&quot;dentro&quot;:&quot;nuvem&quot;},{&quot;id&quot;:&quot;receber-leitura&quot;,&quot;rotulo&quot;:&quot;Receber leitura&quot;,&quot;dentro&quot;:&quot;campo&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;bloco&quot;,&quot;nota&quot;:&quot;umidade, temperatura, CO₂&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;iot core&quot;,&quot;rotulo&quot;:&quot;IoT Core&quot;,&quot;qualificador&quot;:&quot;MQTT, certificado por silo&quot;}},{&quot;id&quot;:&quot;guardar-serie&quot;,&quot;rotulo&quot;:&quot;Guardar a série&quot;,&quot;dentro&quot;:&quot;plataforma&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;bloco&quot;,&quot;nota&quot;:&quot;retenção de 5 safras&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;timestream&quot;,&quot;rotulo&quot;:&quot;Timestream&quot;,&quot;qualificador&quot;:&quot;memória 7 dias, magnético 5 safras&quot;}},{&quot;id&quot;:&quot;detectar-risco&quot;,&quot;rotulo&quot;:&quot;Detectar risco de perda&quot;,&quot;dentro&quot;:&quot;plataforma&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;bloco&quot;,&quot;nota&quot;:&quot;umidade acima da faixa por 40 min&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;lambda&quot;,&quot;rotulo&quot;:&quot;Lambda · janela e regra&quot;}},{&quot;id&quot;:&quot;publicar-evento&quot;,&quot;rotulo&quot;:&quot;Publicar o evento de risco&quot;,&quot;dentro&quot;:&quot;plataforma&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;bloco&quot;,&quot;nota&quot;:&quot;um evento, três interessados&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;eventbridge&quot;,&quot;rotulo&quot;:&quot;EventBridge&quot;,&quot;qualificador&quot;:&quot;um barramento, três regras&quot;}},{&quot;id&quot;:&quot;alertar-tecnico&quot;,&quot;rotulo&quot;:&quot;Alertar o técnico&quot;,&quot;dentro&quot;:&quot;atendimento&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;bloco&quot;,&quot;nota&quot;:&quot;push e SMS, plantão 24h&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;sns&quot;,&quot;rotulo&quot;:&quot;SNS · plantão&quot;}},{&quot;id&quot;:&quot;abrir-visita&quot;,&quot;rotulo&quot;:&quot;Abrir visita técnica&quot;,&quot;dentro&quot;:&quot;atendimento&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;bloco&quot;,&quot;nota&quot;:&quot;agenda o agrônomo mais próximo&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;step functions&quot;,&quot;rotulo&quot;:&quot;Step Functions · agenda a visita&quot;}},{&quot;id&quot;:&quot;painel-semanal&quot;,&quot;rotulo&quot;:&quot;Painel do cooperado&quot;,&quot;dentro&quot;:&quot;atendimento&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;bloco&quot;,&quot;nota&quot;:&quot;consolidado semanal por silo&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;quicksight&quot;,&quot;rotulo&quot;:&quot;QuickSight · painel do cooperado&quot;}},{&quot;id&quot;:&quot;nuvem&quot;,&quot;camada&quot;:&quot;tecnica&quot;,&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;nuvem&quot;,&quot;rotulo&quot;:&quot;AWS Cloud · sa-east-1&quot;}},{&quot;id&quot;:&quot;dlq-alerta&quot;,&quot;camada&quot;:&quot;tecnica&quot;,&quot;dentro&quot;:&quot;atendimento&quot;,&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;sqs&quot;,&quot;rotulo&quot;:&quot;SQS · fila morta do alerta&quot;,&quot;qualificador&quot;:&quot;o ramo que não pode perder evento&quot;}},{&quot;id&quot;:&quot;dlq-visita&quot;,&quot;camada&quot;:&quot;tecnica&quot;,&quot;dentro&quot;:&quot;atendimento&quot;,&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;sqs&quot;,&quot;rotulo&quot;:&quot;SQS · fila morta da visita&quot;}},{&quot;id&quot;:&quot;papel-ingest&quot;,&quot;camada&quot;:&quot;tecnica&quot;,&quot;dentro&quot;:&quot;campo&quot;,&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;iam&quot;,&quot;rotulo&quot;:&quot;Política do IoT Core&quot;,&quot;qualificador&quot;:&quot;só o certificado do silo publica&quot;,&quot;habilita&quot;:&quot;receber-leitura&quot;}}],&quot;arestas&quot;:[{&quot;id&quot;:&quot;a-le&quot;,&quot;de&quot;:&quot;silo&quot;,&quot;para&quot;:&quot;receber-leitura&quot;,&quot;rotulo&quot;:&quot;envia a leitura&quot;,&quot;ordem&quot;:1,&quot;tecnico&quot;:{&quot;rotulo&quot;:&quot;publica a leitura&quot;,&quot;protocolo&quot;:&quot;mqtt&quot;}},{&quot;id&quot;:&quot;a-guarda&quot;,&quot;de&quot;:&quot;receber-leitura&quot;,&quot;para&quot;:&quot;guardar-serie&quot;,&quot;rotulo&quot;:&quot;grava a série&quot;,&quot;ordem&quot;:2},{&quot;id&quot;:&quot;a-detecta&quot;,&quot;de&quot;:&quot;guardar-serie&quot;,&quot;para&quot;:&quot;detectar-risco&quot;,&quot;rotulo&quot;:&quot;avalia a janela&quot;,&quot;ordem&quot;:3},{&quot;id&quot;:&quot;a-publica&quot;,&quot;de&quot;:&quot;detectar-risco&quot;,&quot;para&quot;:&quot;publicar-evento&quot;,&quot;rotulo&quot;:&quot;risco encontrado&quot;,&quot;ordem&quot;:4,&quot;tecnico&quot;:{&quot;rotulo&quot;:&quot;publica o evento de risco&quot;}},{&quot;id&quot;:&quot;a-alerta&quot;,&quot;de&quot;:&quot;publicar-evento&quot;,&quot;para&quot;:&quot;alertar-tecnico&quot;,&quot;rotulo&quot;:&quot;avisa o plantão&quot;,&quot;ordem&quot;:5,&quot;tecnico&quot;:{&quot;rotulo&quot;:&quot;regra: alerta ao plantão&quot;}},{&quot;id&quot;:&quot;a-visita&quot;,&quot;de&quot;:&quot;publicar-evento&quot;,&quot;para&quot;:&quot;abrir-visita&quot;,&quot;rotulo&quot;:&quot;agenda a visita&quot;,&quot;ordem&quot;:6,&quot;tecnico&quot;:{&quot;rotulo&quot;:&quot;regra: abre a visita&quot;}},{&quot;id&quot;:&quot;a-painel&quot;,&quot;de&quot;:&quot;publicar-evento&quot;,&quot;para&quot;:&quot;painel-semanal&quot;,&quot;rotulo&quot;:&quot;alimenta o painel&quot;,&quot;ordem&quot;:7,&quot;tecnico&quot;:{&quot;rotulo&quot;:&quot;regra: alimenta o painel&quot;}},{&quot;id&quot;:&quot;a-tec&quot;,&quot;de&quot;:&quot;agronomo&quot;,&quot;para&quot;:&quot;abrir-visita&quot;,&quot;rotulo&quot;:&quot;confirma ou remarca&quot;,&quot;dados&quot;:&quot;ambos&quot;},{&quot;id&quot;:&quot;a-coop&quot;,&quot;de&quot;:&quot;cooperado&quot;,&quot;para&quot;:&quot;painel-semanal&quot;,&quot;rotulo&quot;:&quot;consulta&quot;,&quot;dados&quot;:&quot;volta&quot;},{&quot;id&quot;:&quot;a-dlq-alerta&quot;,&quot;de&quot;:&quot;alertar-tecnico&quot;,&quot;para&quot;:&quot;dlq-alerta&quot;,&quot;rotulo&quot;:&quot;o que falhou 3×&quot;},{&quot;id&quot;:&quot;a-dlq-visita&quot;,&quot;de&quot;:&quot;abrir-visita&quot;,&quot;para&quot;:&quot;dlq-visita&quot;,&quot;rotulo&quot;:&quot;o que falhou 3×&quot;}],&quot;notas&quot;:[{&quot;id&quot;:&quot;n-fronteira&quot;,&quot;origem&quot;:&quot;premissa&quot;,&quot;texto&quot;:&quot;Os três grupos são fronteiras de RESPONSABILIDADE, não contas AWS. Esta vista foi ao conselho da cooperativa, que não é gente de TI.&quot;},{&quot;id&quot;:&quot;n-dlq&quot;,&quot;origem&quot;:&quot;achado-recusado&quot;,&quot;sobre&quot;:&quot;painel-semanal&quot;,&quot;texto&quot;:&quot;Ramo do painel sem fila morta, conhecido e aceito: perder um evento adia um número no consolidado semanal, e o próximo evento corrige. Os ramos de alerta e visita têm fila morta desde a v1.&quot;}],&quot;dossie&quot;:{&quot;fatos&quot;:[{&quot;fato&quot;:&quot;1.200 silos em 34 unidades armazenadoras, leitura a cada 5 minutos&quot;,&quot;procedencia&quot;:&quot;perguntado&quot;,&quot;confirmado&quot;:true},{&quot;fato&quot;:&quot;a perda por umidade custou R$ 4,1 mi na safra passada&quot;,&quot;procedencia&quot;:&quot;perguntado&quot;,&quot;confirmado&quot;:true},{&quot;fato&quot;:&quot;não há time de infraestrutura — dois desenvolvedores, meio período&quot;,&quot;procedencia&quot;:&quot;perguntado&quot;,&quot;confirmado&quot;:true},{&quot;fato&quot;:&quot;o sensor é 4G e reenvia sozinho por até 6 horas se cair o link&quot;,&quot;procedencia&quot;:&quot;inferido&quot;,&quot;confirmado&quot;:true},{&quot;fato&quot;:&quot;o técnico precisa ser avisado em menos de 15 minutos&quot;,&quot;procedencia&quot;:&quot;perguntado&quot;,&quot;confirmado&quot;:true},{&quot;fato&quot;:&quot;o painel do cooperado é semanal — ninguém olha diariamente&quot;,&quot;procedencia&quot;:&quot;inferido&quot;,&quot;confirmado&quot;:true},{&quot;fato&quot;:&quot;retenção de 5 safras para comparar ano a ano&quot;,&quot;procedencia&quot;:&quot;perguntado&quot;,&quot;confirmado&quot;:true}],&quot;candidatas&quot;:[{&quot;id&quot;:&quot;cand-a&quot;,&quot;nome&quot;:&quot;Leque assíncrono por evento&quot;,&quot;estado&quot;:&quot;escolhida&quot;,&quot;tupla&quot;:[&quot;gerenciado-sem-compute&quot;,&quot;evento&quot;,&quot;serie-temporal&quot;,&quot;privado&quot;,&quot;tres-fronteiras&quot;]}],&quot;achados&quot;:[{&quot;regra&quot;:&quot;assincrono-sem-dlq&quot;,&quot;alvo&quot;:&quot;painel-semanal&quot;,&quot;estado&quot;:&quot;recusado&quot;,&quot;em&quot;:&quot;2026-08-23&quot;,&quot;viaNota&quot;:&quot;n-dlq&quot;},{&quot;regra&quot;:&quot;spof&quot;,&quot;alvo&quot;:&quot;receber-leitura&quot;,&quot;estado&quot;:&quot;aceito&quot;,&quot;em&quot;:&quot;2026-08-23&quot;}],&quot;acordo&quot;:{&quot;vista&quot;:&quot;logica&quot;,&quot;impressao&quot;:&quot;sha256:a044b18a52151b03c60be3c30f12d4e8522b137d4bab298a7fa6e9fc4162b92a&quot;,&quot;em&quot;:&quot;2026-08-23&quot;,&quot;candidata&quot;:&quot;cand-a&quot;}}}">
