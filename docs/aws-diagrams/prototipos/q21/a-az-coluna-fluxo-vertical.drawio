        <mxCell id="t1" value="A · AZ em colunas, fluxo na vertical" style="text;html=1;fontSize=19;fontStyle=1;fontColor=#232F3E;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="34" width="748" height="26" as="geometry"/></mxCell>
        <mxCell id="t2" value="A leitura da lâmina 9 do deck preservada: zona = coluna. O fluxo numerado desce. Contraria O1 (fluxo E→D em 17 de 24 diagramas oficiais)." style="text;html=1;fontSize=12;fontColor=#5A6C86;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="748" height="34" as="geometry"/></mxCell>
        <mxCell id="t3" value="&lt;b&gt;O que olhar:&lt;/b&gt; a faixa de AZ é a coluna, como no deck. O fluxo 1→5 desce contra a convenção mais forte do corpus. Repare na proporção da página e em quanto o ALB e o Auto Scaling group — que cruzam zona — ficam confortáveis nesta orientação." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#AAB7B8;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1221" width="748" height="60" as="geometry"/></mxCell>
