{&quot;id&quot;:&quot;a-consulta&quot;,&quot;from&quot;:&quot;painel&quot;,&quot;to&quot;:&quot;consultar&quot;,&quot;label&quot;:&quot;consulta&quot;,&quot;data&quot;:&quot;back&quot;,&quot;order&quot;:7},{&quot;id&quot;:&quot;a-varre&quot;,&quot;from&quot;:&quot;consultar&quot;,&quot;to&quot;:&quot;reter-objeto&quot;,&quot;label&quot;:&quot;varre o histórico&quot;,&quot;data&quot;:&quot;back&quot;,&quot;order&quot;:8,&quot;technical&quot;:{&quot;label&quot;:&quot;varre o prefixo curado&quot;}},{&quot;id&quot;:&quot;a-avisa-s1&quot;,&quot;from&quot;:&quot;barramento&quot;,&quot;to&quot;:&quot;processar-na-chegada&quot;,&quot;layer&quot;:&quot;both&quot;,&quot;label&quot;:&quot;dispara&quot;},{&quot;id&quot;:&quot;a-le&quot;,&quot;from&quot;:&quot;processar-na-chegada&quot;,&quot;to&quot;:&quot;endpoint-s3&quot;,&quot;layer&quot;:&quot;technical&quot;,&quot;label&quot;:&quot;GetObject&quot;,&quot;data&quot;:&quot;back&quot;},{&quot;id&quot;:&quot;a-le2&quot;,&quot;from&quot;:&quot;endpoint-s3&quot;,&quot;to&quot;:&quot;guardar-bruto&quot;,&quot;layer&quot;:&quot;technical&quot;,&quot;label&quot;:&quot;sem sair da rede AWS&quot;,&quot;data&quot;:&quot;back&quot;},{&quot;id&quot;:&quot;a-confia&quot;,&quot;from&quot;:&quot;processar-na-chegada&quot;,&quot;to&quot;:&quot;papel-leitura&quot;,&quot;layer&quot;:&quot;technical&quot;,&quot;label&quot;:&quot;assume papel&quot;,&quot;protocol&quot;:&quot;sts&quot;}],&quot;notes&quot;:[{&quot;id&quot;:&quot;n-spof&quot;,&quot;origin&quot;:&quot;rejected-finding&quot;,&quot;text&quot;:&quot;SPOF conhecido e aceito: o ponto de entrada de arquivo não tem par. Decisão de orçamento, revisar antes do go-live.&quot;},{&quot;id&quot;:&quot;n-retencao&quot;,&quot;origin&quot;:&quot;assumption&quot;,&quot;about&quot;:&quot;reter-objeto&quot;,&quot;text&quot;:&quot;Histórico de 5 anos por exigência de auditoria, com regra de ciclo de vida.&quot;},{&quot;id&quot;:&quot;n-donos&quot;,&quot;origin&quot;:&quot;legend&quot;,&quot;text&quot;:&quot;Donos das fronteiras — aterrissagem: time de integração · processamento e guarda: time de dados · consumo analítico: BI.&quot;},{&quot;id&quot;:&quot;n-kms&quot;,&quot;layer&quot;:&quot;technical&quot;,&quot;origin&quot;:&quot;assumption&quot;,&quot;text&quot;:&quot;Chave gerenciada pelo cliente (KMS) nas duas zonas do lago — Q7 da sabatina.&quot;}],&quot;dossier&quot;:{&quot;axes&quot;:{&quot;E1&quot;:&quot;gerenciado sem compute próprio&quot;,&quot;E2&quot;:&quot;assíncrono por evento (chegada do arquivo)&quot;,&quot;E3&quot;:&quot;objeto / data lake com camada analítica&quot;,&quot;E4&quot;:&quot;privado, com ponto de entrega controlado&quot;,&quot;E5&quot;:&quot;três fronteiras: aterrissagem, processamento, consumo&quot;},&quot;facts&quot;:[{&quot;fact&quot;:&quot;300 lojas enviam arquivo de venda&quot;,&quot;provenance&quot;:&quot;asked&quot;,&quot;confirmed&quot;:true},{&quot;fact&quot;:&quot;os arquivos caem de madrugada, mas há loja que envia fora de hora&quot;,&quot;provenance&quot;:&quot;inferred&quot;,&quot;confirmed&quot;:true,&quot;from&quot;:&quot;ata de kickoff + Q6&quot;},{&quot;fact&quot;:&quot;4 GB por dia&quot;,&quot;provenance&quot;:&quot;asked&quot;,&quot;confirmed&quot;:true},{&quot;fact&quot;:&quot;histórico de 5 anos por auditoria&quot;,&quot;provenance&quot;:&quot;asked&quot;,&quot;confirmed&quot;:true},{&quot;fact&quot;:&quot;as lojas entregam por SFTP e isso não muda&quot;,&quot;provenance&quot;:&quot;asked&quot;,&quot;confirmed&quot;:true},{&quot;fact&quot;:&quot;sem norma escrita de residência; chave gerenciada pelo cliente&quot;,&quot;provenance&quot;:&quot;inferred&quot;,&quot;confirmed&quot;:true,&quot;from&quot;:&quot;Q7&quot;},{&quot;fact&quot;:&quot;quem inicia a travessia entre fronteiras é o processamento&quot;,&quot;provenance&quot;:&quot;asked&quot;,&quot;confirmed&quot;:true,&quot;from&quot;:&quot;Q9&quot;}],&quot;parking&quot;:[{&quot;name&quot;:&quot;Lambda&quot;,&quot;capability&quot;:&quot;processar-na-chegada&quot;,&quot;state&quot;:&quot;returned&quot;,&quot;note&quot;:&quot;voltou na fase técnica como sugestão inferida contra a capacidade, e foi confirmado (#15 §5).&quot;},{&quot;name&quot;:&quot;S3&quot;,&quot;capability&quot;:&quot;reter-objeto&quot;,&quot;state&quot;:&quot;returned&quot;,&quot;note&quot;:&quot;voltou e foi confirmado, nas duas zonas do lago.&quot;}],&quot;candidates&quot;:[{&quot;id&quot;:&quot;cand-a&quot;,&quot;name&quot;:&quot;Só chegou, já processou&quot;,&quot;state&quot;:&quot;chosen&quot;,&quot;tuple&quot;:[&quot;gerenciado-sem-compute&quot;,&quot;evento&quot;,&quot;data-lake&quot;,&quot;privado&quot;,&quot;multi-fronteira&quot;],&quot;buys&quot;:&quot;painel fresco minutos após a loja enviar; zero runtime seu.&quot;,&quot;pays&quot;:&quot;custo por evento imprevisível em dia de pico; depurar fluxo assíncrono é chato.&quot;,&quot;chooseIf&quot;:&quot;\&quot;painel velho\&quot; é a dor principal da diretoria.&quot;,&quot;wrongIf&quot;:&quot;o volume por loja crescer 10× — aí o custo por evento passa o de lote.&quot;,&quot;because&quot;:&quot;a dor declarada é frescor, e a separação de fronteiras da ata sobrevive.&quot;},{&quot;id&quot;:&quot;cand-b&quot;,&quot;name&quot;:&quot;Micro-lote de 15 minutos&quot;,&quot;state&quot;:&quot;discarded&quot;,&quot;differsIn&quot;:[&quot;E2&quot;],&quot;tuple&quot;:[&quot;gerenciado-sem-compute&quot;,&quot;lote-agendado&quot;,&quot;data-lake&quot;,&quot;privado&quot;,&quot;multi-fronteira&quot;],&quot;buys&quot;:&quot;custo previsível, reprocessamento trivial, uma janela para consertar arquivo torto.&quot;,&quot;pays&quot;:&quot;até 15 min de atraso — a reclamação da diretoria volta menor, não some.&quot;,&quot;chooseIf&quot;:&quot;auditoria e reprocessamento pesam mais que frescor.&quot;,&quot;wrongIf&quot;:&quot;alguém prometeu \&quot;tempo real\&quot; para a diretoria.&quot;,&quot;because&quot;:&quot;descartada: o atraso residual não resolve a dor declarada. Fica em pé se o custo por evento estourar.&quot;},{&quot;id&quot;:&quot;cand-c&quot;,&quot;name&quot;:&quot;Transformação na borda&quot;,&quot;state&quot;:&quot;discarded&quot;,&quot;differsIn&quot;:[&quot;E1&quot;,&quot;E3&quot;,&quot;E5&quot;],&quot;tuple&quot;:[&quot;conteineres&quot;,&quot;evento&quot;,&quot;relacional-gerenciado&quot;,&quot;privado&quot;,&quot;fronteira-unica&quot;],&quot;buys&quot;:&quot;lógica de negócio complexa por loja em código comum; consulta relacional direta.&quot;,&quot;pays&quot;:&quot;você opera cluster; colapsa as três fronteiras e perde a separação de auditoria.&quot;,&quot;chooseIf&quot;:&quot;a transformação por loja for regra de negócio pesada, não parsing.&quot;,&quot;wrongIf&quot;:&quot;a separação de fronteiras for exigência de compliance — e a ata sugere que é.&quot;,&quot;because&quot;:&quot;descartada: perde a fronteira de auditoria, que a ata trata como dada.&quot;}],&quot;findings&quot;:[{&quot;rule&quot;:&quot;spof&quot;,&quot;target&quot;:&quot;receber-arquivo&quot;,&quot;state&quot;:&quot;rejected&quot;,&quot;at&quot;:&quot;2026-08-21&quot;,&quot;viaNote&quot;:&quot;n-spof&quot;,&quot;note&quot;:&quot;ponto de entrada sem par. O time aceitou para a fase 1 por orçamento — vira nota no diagrama, não conserto calado.&quot;},{&quot;rule&quot;:&quot;assincrono-sem-dlq&quot;,&quot;target&quot;:&quot;processar-na-chegada&quot;,&quot;state&quot;:&quot;accepted&quot;,&quot;at&quot;:&quot;2026-08-21&quot;,&quot;note&quot;:&quot;virou a capacidade \&quot;Tratar arquivo que falhou\&quot;.&quot;},{&quot;rule&quot;:&quot;cross-account-sem-confianca&quot;,&quot;target&quot;:&quot;processamento&quot;,&quot;state&quot;:&quot;accepted&quot;,&quot;at&quot;:&quot;2026-08-21&quot;,&quot;note&quot;:&quot;a travessia entre fronteiras precisa de caminho de confiança declarado — desenha na fase técnica.&quot;},{&quot;rule&quot;:&quot;retencao-sem-regra&quot;,&quot;target&quot;:&quot;reter-objeto&quot;,&quot;state&quot;:&quot;accepted&quot;,&quot;at&quot;:&quot;2026-08-21&quot;,&quot;note&quo