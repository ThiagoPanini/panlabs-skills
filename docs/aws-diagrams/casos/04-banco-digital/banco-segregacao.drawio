ara&quot;:&quot;saldo&quot;,&quot;rotulo&quot;:&quot;cria o saldo inicial&quot;},{&quot;de&quot;:&quot;achado&quot;,&quot;para&quot;:&quot;trilha&quot;,&quot;rotulo&quot;:&quot;guarda o achado&quot;},{&quot;de&quot;:&quot;consolidar&quot;,&quot;para&quot;:&quot;regulador&quot;,&quot;rotulo&quot;:&quot;envia o CADOC&quot;},{&quot;de&quot;:&quot;consolidar&quot;,&quot;para&quot;:&quot;saldo&quot;,&quot;rotulo&quot;:&quot;lê a posição do dia&quot;,&quot;dados&quot;:&quot;volta&quot;},{&quot;de&quot;:&quot;consolidar&quot;,&quot;para&quot;:&quot;trilha&quot;,&quot;rotulo&quot;:&quot;grava a trilha do envio&quot;},{&quot;de&quot;:&quot;correntista&quot;,&quot;para&quot;:&quot;abrir-conta&quot;,&quot;rotulo&quot;:&quot;abre a conta&quot;},{&quot;de&quot;:&quot;correntista&quot;,&quot;para&quot;:&quot;movimentar&quot;,&quot;rotulo&quot;:&quot;movimenta&quot;},{&quot;de&quot;:&quot;movimentar&quot;,&quot;para&quot;:&quot;saldo&quot;,&quot;rotulo&quot;:&quot;debita e credita&quot;},{&quot;de&quot;:&quot;movimentar&quot;,&quot;para&quot;:&quot;trilha&quot;,&quot;rotulo&quot;:&quot;grava a trilha da movimentação&quot;},{&quot;de&quot;:&quot;risco&quot;,&quot;para&quot;:&quot;saldo&quot;,&quot;rotulo&quot;:&quot;lê o histórico&quot;,&quot;dados&quot;:&quot;volta&quot;}],&quot;notas&quot;:[{&quot;texto&quot;:&quot;As três fronteiras são de RESPONSABILIDADE. Que elas virem três contas AWS é decisão da fase técnica — o comitê de risco aprovou a segregação, não a conta.&quot;,&quot;origem&quot;:&quot;premissa&quot;},{&quot;texto&quot;:&quot;Modelo de risco lendo o transacional direto, conhecido e aceito para a v1: a cópia analítica atrasa o limite de crédito em 24 h, e o produto não aceita. Revisar quando o volume dobrar.&quot;,&quot;sobre&quot;:&quot;risco&quot;,&quot;origem&quot;:&quot;achado-recusado&quot;},{&quot;texto&quot;:&quot;Ninguém de fora da auditoria escreve na trilha, e a auditoria não lê o transacional. A direção da confiança é requisito do BACEN, não preferência.&quot;,&quot;sobre&quot;:&quot;trilha&quot;,&quot;origem&quot;:&quot;premissa&quot;}]},&quot;em&quot;:&quot;2026-08-23&quot;,&quot;por&quot;:&quot;comite de risco&quot;,&quot;candidata&quot;:&quot;cand-a&quot;}}}">
          <mxCell style="text;html=1;" vertex="1" parent="1" visible="0">
            <mxGeometry x="0" y="0" width="1" height="1" as="geometry"/>
          </mxCell>
