        <mxCell id="notas" value="Dado de saúde é dado pessoal sensível (LGPD art. 11): nada do prontuário em subnet pública, e o egress passa só pelo NAT." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#B7791F;fontColor=#6B4E00;fontFamily=Arial,Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;dashed=0;" vertex="1" parent="1">
