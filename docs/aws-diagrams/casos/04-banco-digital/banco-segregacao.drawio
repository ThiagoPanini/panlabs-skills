mil TPS no pico&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;ecs&quot;,&quot;rotulo&quot;:&quot;ECS · motor de movimentação&quot;,&quot;qualificador&quot;:&quot;2,1 mil TPS no pico do dia 5&quot;}},{&quot;id&quot;:&quot;saldo&quot;,&quot;rotulo&quot;:&quot;Guarda do saldo&quot;,&quot;dentro&quot;:&quot;f-transacional&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;bloco&quot;,&quot;qualificador&quot;:&quot;a verdade contábil; tudo o mais é derivado&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;aurora&quot;,&quot;rotulo&quot;:&quot;Aurora PostgreSQL · razão&quot;,&quot;qualificador&quot;:&quot;a verdade contábil&quot;}},{&quot;id&quot;:&quot;consolidar&quot;,&quot;rotulo&quot;:&quot;Consolidação regulatória&quot;,&quot;dentro&quot;:&quot;f-analitico&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;bloco&quot;,&quot;qualificador&quot;:&quot;monta o CADOC do dia&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;athena&quot;,&quot;rotulo&quot;:&quot;Athena · consolidação do CADOC&quot;}},{&quot;id&quot;:&quot;risco&quot;,&quot;rotulo&quot;:&quot;Modelo de risco&quot;,&quot;dentro&quot;:&quot;f-analitico&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;bloco&quot;,&quot;qualificador&quot;:&quot;limite de crédito por correntista&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;sagemaker&quot;,&quot;rotulo&quot;:&quot;SageMaker · limite de crédito&quot;}},{&quot;id&quot;:&quot;trilha&quot;,&quot;rotulo&quot;:&quot;Trilha imutável&quot;,&quot;dentro&quot;:&quot;f-auditoria&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;bloco&quot;,&quot;qualificador&quot;:&quot;5 anos, sem apagar — nem o administrador&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;s3&quot;,&quot;rotulo&quot;:&quot;S3 · trilha com Object Lock&quot;,&quot;qualificador&quot;:&quot;5 anos, modo