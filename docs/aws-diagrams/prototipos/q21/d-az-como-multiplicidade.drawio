        <mxCell id="t1" value="D · Sem faixa de AZ: a zona vira multiplicidade declarada" style="text;html=1;fontSize=19;fontStyle=1;fontColor=#232F3E;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="34" width="1494" height="26" as="geometry"/></mxCell>
        <mxCell id="t2" value="O gênero T4 puro. A redundância zonal é dita em texto (&quot;×3, uma por AZ&quot;) em vez de desenhada. O eixo horizontal fica inteiro com o fluxo." style="text;html=1;fontSize=12;fontColor=#5A6C86;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1494" height="34" as="geometry"/></mxCell>
        <mxCell id="t3" value="&lt;b&gt;O que olhar:&lt;/b&gt; o diagrama mais legível dos quatro — e o que menos afirma. Não dá para ver QUE recurso está em QUE zona, nem que o RDS standby vive em 1b. Serve quando a zona não é o assunto; mente por omissão quando é." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#AAB7B8;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="384" width="1494" height="60" as="geometry"/></mxCell>
