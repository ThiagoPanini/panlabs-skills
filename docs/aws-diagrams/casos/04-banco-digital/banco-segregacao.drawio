        <object id="panlabs-modelo" label="" panlabsEsquema="panlabs-aws-diagrams/sessao@1" panlabsVista="tecnica" panlabsSemantica="sha256:db347a901931852ddadfc504843583c930662a0a6a7e9617c1a5a38cde2db350" panlabsAparencia="sha256:1b4d0940bed0a5d2ee27ac741cfff45de1ca2c8038b0c59fc029b4308536af12" panlabsMotor="panlabs-aws-diagrams/motor@1" panlabsSessao="{&quot;esquema&quot;:&quot;panlabs-aws-diagrams/sessao@1&quot;,&quot;id&quot;:&quot;banco-segregacao&quot;,&quot;titulo&quot;:&quot;Banco digital · segregação regulatória&quot;,&quot;estagio&quot;:&quot;tecnica&quot;,&quot;vistas&quot;:{&quot;logica&quot;:{&quot;genero&quot;:&quot;L1&quot;,&quot;titulo&quot;:&quot;Banco digital · segregação regulatória · vista lógica&quot;,&quot;subtitulo&quot;:&quot;Capacidades e fronteiras de responsabilidade — a vista que foi ao comitê de risco e ao compliance.&quot;},&quot;tecnica&quot;:{&quot;genero&quot;:&quot;T5&quot;,&quot;titulo&quot;:&quot;Banco digital · segregação regulatória · vista técnica&quot;,&quot;subtitulo&quot;:&quot;T5 multi-account · as MESMAS fronteiras aprovadas, agora como contas AWS sob unidade organizacional.&quot;}},&quot;nos&quot;:[{&quot;id&quot;:&quot;correntista&quot;,&quot;rotulo&quot;:&quot;Correntistas&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;ator&quot;,&quot;nota&quot;:&quot;410 mil contas ativas&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;ator&quot;,&quot;servico&quot;:&quot;users&quot;,&quot;rotulo&quot;:&quot;Correntistas&quot;}},{&quot;id&quot;:&quot;regulador&quot;,&quot;rotulo&quot;:&quot;Regulador&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;ator&quot;,&quot;nota&quot;:&quot;envio diário do CADOC&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;ator&quot;,&quot;servico&quot;:&quot;users&quot;,&quot;rotulo&quot;:&quot;BACEN&quot;}},{&quot;id&quot;:&quot;f-transacional&quot;,&quot;rotulo&quot;:&quot;Transacional&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;grupo&quot;,&quot;nota&quot;:&quot;dono: engenharia de core banking&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;conta&quot;,&quot;conta&quot;:&quot;200000000001&quot;,&quot;ou&quot;:&quot;Workloads&quot;,&quot;rotulo&quot;:&quot;Transacional&quot;,&quot;qualificador&quot;:&quot;core banking — o caminho quente&quot;}},{&quot;id&quot;:&quot;f-analitico&quot;,&quot;rotulo&quot;:&quot;Analítico e regulatório&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;grupo&quot;,&quot;nota&quot;:&quot;dono: risco e compliance&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;conta&quot;,&quot;conta&quot;:&quot;200000000002&quot;,&quot;ou&quot;:&quot;Workloads&quot;,&quot;rotulo&quot;:&quot;Analítico e regulatório&quot;,&quot;qualificador&quot;:&quot;risco e CADOC&quot;}},{&quot;id&quot;:&quot;f-auditoria&quot;,&quot;rotulo&quot;:&quot;Auditoria&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;grupo&quot;,&quot;nota&quot;:&quot;dono: auditoria interna — ninguém de fora escreve aqui&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;conta&quot;,&quot;conta&quot;:&quot;200000000003&quot;,&quot;ou&quot;:&quot;Security&quot;,&quot;rotulo&quot;:&quot;Auditoria&quot;,&quot;qualificador&quot;:&quot;escrita só de dentro; leitura só pela auditoria&quot;}},{&quot;id&quot;:&quot;abrir-conta&quot;,&quot;rotulo&quot;:&quot;Abertura de conta&quot;,&quot;dentro&quot;:&quot;f-transacional&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;bloco&quot;,&quot;nota&quot;:&quot;KYC e prova de vida&quot;,&quot;qualificador&quot;:&quot;onde o CPF vira cliente&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;step functions&quot;,&quot;rotulo&quot;:&quot;Step Functions · KYC&quot;,&quot;qualificador&quot;:&quot;prova de vida e bureau&quot;}},{&quot;id&quot;:&quot;movimentar&quot;,&quot;rotulo&quot;:&quot;Movimentação&quot;,&quot;dentro&quot;:&quot;f-transacional&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;bloco&quot;,&quot;nota&quot;:&quot;Pix, TED, boleto&quot;,&quot;qualificador&quot;:&quot;o caminho quente — 2,1 mil TPS no pico&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;ecs&quot;,&quot;rotulo&quot;:&quot;ECS · motor de movimentação&quot;,&quot;qualificador&quot;:&quot;2,1 mil TPS no pico do dia 5&quot;}},{&quot;id&quot;:&quot;saldo&quot;,&quot;rotulo&quot;:&quot;Guarda do saldo&quot;,&quot;dentro&quot;:&quot;f-transacional&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;bloco&quot;,&quot;qualificador&quot;:&quot;a verdade contábil; tudo o mais é derivado&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;aurora&quot;,&quot;rotulo&quot;:&quot;Aurora PostgreSQL · razão&quot;,&quot;qualificador&quot;:&quot;a verdade contábil&quot;}},{&quot;id&quot;:&quot;consolidar&quot;,&quot;rotulo&quot;:&quot;Consolidação regulatória&quot;,&quot;dentro&quot;:&quot;f-analitico&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;bloco&quot;,&quot;qualificador&quot;:&quot;monta o CADOC do dia&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;athena&quot;,&quot;rotulo&quot;:&quot;Athena · consolidação do CADOC&quot;}},{&quot;id&quot;:&quot;risco&quot;,&quot;rotulo&quot;:&quot;Modelo de risco&quot;,&quot;dentro&quot;:&quot;f-analitico&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;bloco&quot;,&quot;qualificador&quot;:&quot;limite de crédito por correntista&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;sagemaker&quot;,&quot;rotulo&quot;:&quot;SageMaker · limite de crédito&quot;}},{&quot;id&quot;:&quot;trilha&quot;,&quot;rotulo&quot;:&quot;Trilha imutável&quot;,&quot;dentro&quot;:&quot;f-auditoria&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;bloco&quot;,&quot;qualificador&quot;:&quot;5 anos, sem apagar — nem o administrador&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;s3&quot;,&quot;rotulo&quot;:&quot;S3 · trilha com Object Lock&quot;,&quot;qualificador&quot;:&quot;5 anos, modo compliance&quot;}},{&quot;id&quot;:&quot;achado&quot;,&quot;rotulo&quot;:&quot;Achados de segurança&quot;,&quot;dentro&quot;:&quot;f-auditoria&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;bloco&quot;,&quot;qualificador&quot;:&quot;consolida as três fronteiras&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;security hub&quot;,&quot;rotulo&quot;:&quot;Security Hub&quot;,&quot;qualificador&quot;:&quot;agrega as três contas&quot;}},{&quot;id&quot;:&quot;papel-risco&quot;,&quot;camada&quot;:&quot;tecnica&quot;,&quot;dentro&quot;:&quot;f-transacional&quot;,&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;iam&quot;,&quot;rotulo&quot;:&quot;Papel de leitura do risco&quot;,&quot;qualificador&quot;:&quot;confiança declarada para a conta analítica, só leitura&quot;,&quot;habilita&quot;:&quot;saldo&quot;}},{&quot;id&quot;:&quot;papel-trilha&quot;,&quot;camada&quot;:&quot;tecnica&quot;,&quot;dentro&quot;:&quot;f-auditoria&quot;,&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;iam&quot;,&quot;rotulo&quot;:&quot;Papel de escrita na trilha&quot;,&quot;qualificador&quot;:&quot;as duas contas de workload escrevem; nenhuma apaga&quot;,&quot;habilita&quot;:&quot;trilha&quot;}},{&quot;id&quot;:&quot;chave-trilha&quot;,&quot;camada&quot;:&quot;tecnica&quot;,&quot;dentro&quot;:&quot;f-auditoria&quot;,&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;kms&quot;,&quot;rotulo&quot;:&quot;KMS · chave da auditoria&quot;,&quot;qualificador&quot;:&quot;a chave não sai da conta de auditoria&quot;}}],&quot;arestas&quot;:[{&quot;id&quot;:&quot;a-abre&quot;,&quot;de&quot;:&quot;correntista&quot;,&quot;para&quot;:&quot;abrir-conta&quot;,&quot;rotulo&quot;:&quot;abre a conta&quot;},{&quot;id&quot;:&quot;a-move&quot;,&quot;de&quot;:&quot;correntista&quot;,&quot;para&quot;:&quot;movimentar&quot;,&quot;rotulo&quot;:&quot;movimenta&quot;},{&quot;id&quot;:&quot;a-debita&quot;,&quot;de&quot;:&quot;movimentar&quot;,&quot;para&quot;:&quot;saldo&quot;,&quot;rotulo&quot;:&quot;debita e credita&quot;,&quot;tecnico&quot;:{&quot;rotulo&quot;:&quot;debita e credita&quot;,&quot;protocolo&quot;:&quot;sql&quot;}},{&quot;id&quot;:&quot;a-cria&quot;,&quot;de&quot;:&quot;abrir-conta&quot;,&quot;para&quot;:&quot;saldo&quot;,&quot;rotulo&quot;:&quot;cria o saldo inicial&quot;},{&quot;id&quot;:&quot;a-consolida&quot;,&quot;de&quot;:&quot;consolidar&quot;,&quot;para&quot;:&quot;saldo&quot;,&quot;rotulo&quot;:&quot;lê a posição do dia&quot;,&quot;dados&quot;:&quot;volta&quot;,&quot;tecnico&quot;:{&quot;rotulo&quot;:&quot;lê a posição do dia&quot;,&quot;protocolo&quot;:&quot;sql&quot;}},{&quot;id&quot;:&quot;a-risco&quot;,&quot;de&quot;:&quot;risco&quot;,&quot;para&quot;:&quot;saldo&quot;,&quot;rotulo&quot;:&quot;lê o histórico&quot;,&quot;dados&quot;:&quot;volta&quot;,&quot;tecnico&quot;:{&quot;rotulo&quot;:&quot;assume o papel e lê o histórico&quot;,&quot;protocolo&quot;:&quot;sts&quot;}},{&quot;id&quot;:&quot;a-envia&quot;,&quot;de&quot;:&quot;consolidar&quot;,&quot;para&quot;:&quot;regulador&quot;,&quot;rotulo&quot;:&quot;envia o CADOC&quot;,&quot;tecnico&quot;:{&quot;rotulo&quot;:&quot;envia o CADOC&quot;,&quot;protocolo&quot;:&quot;sftp&quot;}},{&quot;id&quot;:&quot;a-trilha-t&quot;,&quot;de&quot;:&quot;movimentar&quot;,&quot;para&quot;:&quot;trilha&quot;,&quot;rotulo&quot;:&quot;grava a trilha da movimentação&quot;},{&quot;id&quot;:&quot;a-trilha-a&quot;,&quot;de&quot;:&quot;consolidar&quot;,&quot;para&quot;:&quot;trilha&quot;,&quot;rotulo&quot;:&quot;grava a trilha do envio&quot;},{&quot;id&quot;:&quot;a-achado&quot;,&quot;de&quot;:&quot;achado&quot;,&quot;para&quot;:&quot;trilha&quot;,&quot;rotulo&quot;:&quot;guarda o achado&quot;},{&quot;id&quot;:&quot;a-cifra&quot;,&quot;de&quot;:&quot;trilha&quot;,&quot;para&quot;:&quot;chave-trilha&quot;,&quot;rotulo&quot;:&quot;cifra em repouso&quot;}],&quot;notas&quot;:[{&quot;id&quot;:&quot;n-fronteira&quot;,&quot;origem&quot;:&quot;premissa&quot;,&quot;texto&quot;:&quot;As três fronteiras são de RESPONSABILIDADE. Que elas virem três contas AWS é decisão da fase técnica — o comitê de risco aprovou a segregação, não a conta.&quot;},{&quot;id&quot;:&quot;n-escrita&quot;,&quot;origem&quot;:&quot;premissa&quot;,&quot;sobre&quot;:&quot;trilha&quot;,&quot;texto&quot;:&quot;Ninguém de fora da auditoria escreve na trilha, e a auditoria não lê o transacional. A direção da confiança é requisito do BACEN, não preferência.&quot;},{&quot;id&quot;:&quot;n-risco&quot;,&quot;origem&quot;:&quot;achado-recusado&quot;,&quot;sobre&quot;:&quot;risco&quot;,&quot;texto&quot;:&quot;Modelo de risco lendo o transacional direto, conhecido e aceito para a v1: a cópia analítica atrasa o limite de crédito em 24 h, e o produto não aceita. Revisar quando o volume dobrar.&quot;}],&quot;dossie&quot;:{&quot;fatos&quot;:[{&quot;fato&quot;:&quot;410 mil contas ativas, pico de 2,1 mil TPS no dia 5 de cada mês&quot;,&quot;procedencia&quot;:&quot;perguntado&quot;,&quot;confirmado&quot;:true},{&quot;fato&quot;:&quot;o BACEN exige segregação entre quem opera e quem audita&quot;,&quot;procedencia&quot;:&quot;perguntado&quot;,&quot;confirmado&quot;:true},{&quot;fato&quot;:&quot;CADOC diário, com janela de correção de 24 h&quot;,&quot;procedencia&quot;:&quot;perguntado&quot;,&quot;confirmado&quot;:true},{&quot;fato&quot;:&quot;trilha retida por 5 anos, imutável&quot;,&quot;procedencia&quot;:&quot;perguntado&quot;,&quot;confirmado&quot;:true},{&quot;fato&quot;:&quot;o time de risco quer ler o transacional sem esperar cópia&quot;,&quot;procedencia&quot;:&quot;inferido&quot;,&quot;de&quot;:&quot;\&quot;a gente não pode dar limite com dado de ontem\&quot;&quot;,&quot;confirmado&quot;:true},{&quot;fato&quot;:&quot;não há apetite para uma quarta fronteira agora&quot;,&quot;procedencia&quot;:&quot;perguntado&quot;,&quot;confirmado&quot;:true}],&quot;candidatas&quot;:[{&quot;id&quot;:&quot;cand-a&quot;,&quot;nome&quot;:&quot;Três fronteiras com leitura cruzada explícita&quot;,&quot;estado&quot;:&quot;escolhida&quot;,&quot;tupla&quot;:[&quot;gerenciado-sem-compute&quot;,&quot;sincrono-em-cadeia&quot;,&quot;relacional&quot;,&quot;privado&quot;,&quot;tres-fronteiras&quot;],&quot;compra&quot;:&quot;a segregação que o regulador cobra, com o limite de crédito em tempo real que o produto exige&quot;,&quot;paga&quot;:&quot;uma travessia de leitura do analítico para o transacional, que precisa de confiança declarada e auditada&quot;,&quot;escolhaSe&quot;:&quot;o limite de crédito não pode atrasar 24 h&quot;,&quot;erradaSe&quot;:&quot;o regulador vetar qualquer leitura cruzada do transacional&quot;},{&quot;id&quot;:&quot;cand-b&quot;,&quot;nome&quot;:&quot;Três fronteiras com cópia analítica&quot;,&quot;estado&quot;:&quot;descartada&quot;,&quot;tupla&quot;:[&quot;gerenciado-sem-compute&quot;,&quot;lote-agendado&quot;,&quot;relacional&quot;,&quot;privado&quot;,&quot;tres-fronteiras&quot;],&quot;difereEm&quot;:[&quot;E2&quot;],&quot;compra&quot;:&quot;zero leitura cruzada — a fronteira analítica nunca toca o transacional&quot;,&quot;paga&quot;:&quot;o limite de crédito passa a ser de ontem&quot;,&quot;escolhaSe&quot;:&quot;a segregação valer mais que a atualidade do limite&quot;,&quot;erradaSe&quot;:&quot;o produto depender de limite do dia&quot;,&quot;porque&quot;:&quot;o fato confirmado diz que não dá para dar limite com dado de ontem; esta candidata contradiz o requisito que abriu o projeto&quot;},{&quot;id&quot;:&quot;cand-c&quot;,&quot;nome&quot;:&quot;Duas fronteiras, auditoria dentro do analítico&quot;,&quot;estado&quot;:&quot;descartada&quot;,&quot;tupla&quot;:[&quot;gerenciado-sem-compute&quot;,&quot;sincrono-em-cadeia&quot;,&quot;relacional&quot;,&quot;privado&quot;,&quot;duas-fronteiras&quot;],&quot;difereEm&quot;:[&quot;E5&quot;],&quot;compra&quot;:&quot;uma conta a menos para operar, e o time de risco já opera as duas&quot;,&quot;paga&quot;:&quot;quem audita passa a ser subordinado a quem é auditado&quot;,&quot;escolhaSe&quot;:&quot;não houvesse exigência de segregação&quot;,&quot;erradaSe&quot;:&quot;o regulador olhar a cadeia de comando&quot;,&quot;porque&quot;:&quot;é exatamente a segregação que o BACEN cobra; a economia de uma conta não paga o achado de auditoria&quot;}],&quot;achados&quot;:[{&quot;regra&quot;:&quot;cross-account-sem-confianca&quot;,&quot;alvo&quot;:&quot;risco&quot;,&quot;estado&quot;:&quot;aceito&quot;,&quot;em&quot;:&quot;2026-08-23&quot;,&quot;nota&quot;:&quot;consertado antes do desenho: a leitura passa por papel com confiança declarada, e a fase técnica desenha o papel&quot;},{&quot;regra&quot;:&quot;leitura-cruzada-do-transacional&quot;,&quot;alvo&quot;:&quot;risco&quot;,&quot;estado&quot;:&quot;recusado&quot;,&quot;em&quot;:&quot;2026-08-23&quot;,&quot;viaNota&quot;:&quot;n-risco&quot;,&quot;nota&quot;:&quot;aceito para a v1 por requisito de produto&quot;}],&quot;estacionamento&quot;:[{&quot;nome&quot;:&quot;Aurora&quot;,&quot;capacidade&quot;:&quot;saldo&quot;,&quot;estado&quot;:&quot;estacionado&quot;,&quot;nota&quot;:&quot;dito na primeira frase da reunião&quot;},{&quot;nome&quot;:&quot;Control Tower&quot;,&quot;capacidade&quot;:&quot;f-auditoria&quot;,&quot;estado&quot;:&quot;estacionado&quot;,&quot;nota&quot;:&quot;\&quot;a gente já tem landing zone\&quot; — confirmar na fase técnica&quot;},{&quot;nome&quot;:&quot;Athena&quot;,&quot;capacidade&quot;:&quot;consolidar&quot;,&quot;estado&quot;:&quot;estacionado&quot;,&quot;nota&quot;:&quot;hedge do time de dados&quot;}],&quot;acordo&quot;:{&quot;vista&quot;:&quot;logica&quot;,&quot;impressao&quot;:&quot;sha256:f4be608b5d55073d918b074d396287c71a1a078a02d5e40223d67526f133ed9c&quot;,&quot;recorte&quot;:{&quot;nos&quot;:[{&quot;id&quot;:&quot;abrir-conta&quot;,&quot;tipo&quot;:&quot;bloco&quot;,&quot;rotulo&quot;:&quot;Abertura de conta&quot;,&quot;dentro&quot;:&quot;f-transacional&quot;,&quot;nota&quot;:&quot;KYC e prova de vida&quot;},{&quot;id&quot;:&quot;achado&quot;,&quot;tipo&quot;:&quot;bloco&quot;,&quot;rotulo&quot;:&quot;Achados de segurança&quot;,&quot;dentro&quot;:&quot;f-auditoria&quot;},{&quot;id&quot;:&quot;consolidar&quot;,&quot;tipo&quot;:&quot;bloco&quot;,&quot;rotulo&quot;:&quot;Consolidação regulatória&quot;,&quot;dentro&quot;:&quot;f-analitico&quot;},{&quot;id&quot;:&quot;correntista&quot;,&quot;tipo&quot;:&quot;ator&quot;,&quot;rotulo&quot;:&quot;Correntistas&quot;,&quot;nota&quot;:&quot;410 mil contas ativas&quot;},{&quot;id&quot;:&quot;f-analitico&quot;,&quot;tipo&quot;:&quot;grupo&quot;,&quot;rotulo&quot;:&quot;Analítico e regulatório&quot;,&quot;nota&quot;:&quot;dono: risco e compliance&quot;},{&quot;id&quot;:&quot;f-auditoria&quot;,&quot;tipo&quot;:&quot;grupo&quot;,&quot;rotulo&quot;:&quot;Auditoria&quot;,&quot;nota&quot;:&quot;dono: auditoria interna — ninguém de fora escreve aqui&quot;},{&quot;id&quot;:&quot;f-transacional&quot;,&quot;tipo&quot;:&quot;grupo&quot;,&quot;rotulo&quot;:&quot;Transacional&quot;,&quot;nota&quot;:&quot;dono: engenharia de core banking&quot;},{&quot;id&quot;:&quot;movimentar&quot;,&quot;tipo&quot;:&quot;bloco&quot;,&quot;rotulo&quot;:&quot;Movimentação&quot;,&quot;dentro&quot;:&quot;f-transacional&quot;,&quot;nota&quot;:&quot;Pix, TED, boleto&quot;},{&quot;id&quot;:&quot;regulador&quot;,&quot;tipo&quot;:&quot;ator&quot;,&quot;rotulo&quot;:&quot;Regulador&quot;,&quot;nota&quot;:&quot;envio diário do CADOC&quot;},{&quot;id&quot;:&quot;risco&quot;,&quot;tipo&quot;:&quot;bloco&quot;,&quot;rotulo&quot;:&quot;Modelo de risco&quot;,&quot;dentro&quot;:&quot;f-analitico&quot;},{&quot;id&quot;:&quot;saldo&quot;,&quot;tipo&quot;:&quot;bloco&quot;,&quot;rotulo&quot;:&quot;Guarda do saldo&quot;,&quot;dentro&quot;:&quot;f-transacional&quot;},{&quot;id&quot;:&quot;trilha&quot;,&quot;tipo&quot;:&quot;bloco&quot;,&quot;rotulo&quot;:&quot;Trilha imutável&quot;,&quot;dentro&quot;:&quot;f-auditoria&quot;}],&quot;arestas&quot;:[{&quot;de&quot;:&quot;abrir-conta&quot;,&quot;para&quot;:&quot;saldo&quot;,&quot;rotulo&quot;:&quot;cria o saldo inicial&quot;},{&quot;de&quot;:&quot;achado&quot;,&quot;para&quot;:&quot;trilha&quot;,&quot;rotulo&quot;:&quot;guarda o achado&quot;},{&quot;de&quot;:&quot;consolidar&quot;,&quot;para&quot;:&quot;regulador&quot;,&quot;rotulo&quot;:&quot;envia o CADOC&quot;},{&quot;de&quot;:&quot;consolidar&quot;,&quot;para&quot;:&quot;saldo&quot;,&quot;rotulo&quot;:&quot;lê a posição do dia&quot;,&quot;dados&quot;:&quot;volta&quot;},{&quot;de&quot;:&quot;consolidar&quot;,&quot;para&quot;:&quot;trilha&quot;,&quot;rotulo&quot;:&quot;grava a trilha do envio&quot;},{&quot;de&quot;:&quot;correntista&quot;,&quot;para&quot;:&quot;abrir-conta&quot;,&quot;rotulo&quot;:&quot;abre a conta&quot;},{&quot;de&quot;:&quot;correntista&quot;,&quot;para&quot;:&quot;movimentar&quot;,&quot;rotulo&quot;:&quot;movimenta&quot;},{&quot;de&quot;:&quot;movimentar&quot;,&quot;para&quot;:&quot;saldo&quot;,&quot;rotulo&quot;:&quot;debita e credita&quot;},{&quot;de&quot;:&quot;movimentar&quot;,&quot;para&quot;:&quot;trilha&quot;,&quot;rotulo&quot;:&quot;grava a trilha da movimentação&quot;},{&quot;de&quot;:&quot;risco&quot;,&quot;para&quot;:&quot;saldo&quot;,&quot;rotulo&quot;:&quot;lê o histórico&quot;,&quot;dados&quot;:&quot;volta&quot;}],&quot;notas&quot;:[{&quot;texto&quot;:&quot;As três fronteiras são de RESPONSABILIDADE. Que elas virem três contas AWS é decisão da fase técnica — o comitê de risco aprovou a segregação, não a conta.&quot;,&quot;origem&quot;:&quot;premissa&quot;},{&quot;texto&quot;:&quot;Modelo de risco lendo o transacional direto, conhecido e aceito para a v1: a cópia analítica atrasa o limite de crédito em 24 h, e o produto não aceita. Revisar quando o volume dobrar.&quot;,&quot;sobre&quot;:&quot;risco&quot;,&quot;origem&quot;:&quot;achado-recusado&quot;},{&quot;texto&quot;:&quot;Ninguém de fora da auditoria escreve na trilha, e a auditoria não lê o transacional. A direção da confiança é requisito do BACEN, não preferência.&quot;,&quot;sobre&quot;:&quot;trilha&quot;,&quot;origem&quot;:&quot;premissa&quot;}]},&quot;em&quot;:&quot;2026-08-23&quot;,&quot;por&quot;:&quot;comite de risco&quot;,&quot;candidata&quot;:&quot;cand-a&quot;}}}">
          <mxCell style="text;html=1;" vertex="1" parent="1" visible="0">
