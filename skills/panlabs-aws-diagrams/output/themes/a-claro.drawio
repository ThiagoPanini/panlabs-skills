ot;:&quot;síncrono request/response&quot;,&quot;E3&quot;:&quot;relacional para catálogo, chave-valor para pedido&quot;,&quot;E4&quot;:&quot;exposto por API pública, dado em subnet privada&quot;,&quot;E5&quot;:&quot;conta única&quot;},&quot;candidates&quot;:[{&quot;name&quot;:&quot;Serverless puro&quot;,&quot;tuple&quot;:[&quot;serverless&quot;,&quot;sincrono&quot;,&quot;misto&quot;,&quot;public&quot;,&quot;conta-unica&quot;],&quot;chosen&quot;:true},{&quot;name&quot;:&quot;Containers no ECS&quot;,&quot;tuple&quot;:[&quot;container&quot;,&quot;sincrono&quot;,&quot;misto&quot;,&quot;public&quot;,&quot;conta-unica&quot;],&quot;chosen&quot;:false,&quot;differsIn&quot;:&quot;E1&quot;}],&quot;facts&quot;:[{&quot;fact&quot;:&quot;300 pedidos por minuto no pico&quot;,&quot;provenance&quot;:&quot;asked&quot;,&quot;confirmed&quot;:true},{&quot;fact&quot;:&quot;catálogo já vive em Postgres&quot;,&quot;provenance&quot;:&quot;asked&quot;,&quot;confirmed&quot;:true},{&quot;fact&quot;:&quot;sem requisito de multi-região&quot;,&quot;provenance&quot;:&quot;inferred&quot;,&quot;confirmed&quot;:true}],&quot;parking&quot;:[&quot;o usuário disse &#39;Lambda&#39; no primeiro minuto — voltou na fase técnica, confirmado&quot;],&quot;findings&quot;:[{&quot;rule&quot;:&quot;spof&quot;,&quot;target&quot;:&quot;rds&quot;,&quot;state&quot;:&quot;rejected&quot;,&quot;note&quot;:&quot;aceito para o piloto&quot;},{&quot;rule&quot;:&quot;egress-sem-controle&quot;,&quot;target&quot;:&quot;sub-priv&quot;,&quot;state&quot;:&quot;resolved&quot;,&quot;note&quot;:&quot;VPC endpoint em vez de NAT&quot;}]}}" panlabsTema="{&quot;id&quot;:&quot;light&quot;,&quot;background&quot;:&quot;light&quot;,&quot;tokens&quot;:{&quot;page&quot;:{&quot;color&quot;:&quot;#FFFFFF&quot;,&quot;margin&quot;:32},&quot;group&quot;:{&quot;tint&quot;:&quot;derived&quot;},&quot;ink&quot;:{&quot;strong&quot;:&quot;#232F3E&quot;,&quot;weak&quot;:&quot;#5A6C86&quot;,&quot;halo&quot;:&quot;#FFFFFF&quot;},&quot;text&quot;:{&quot;family