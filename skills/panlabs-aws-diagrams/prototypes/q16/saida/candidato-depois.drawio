        <mxCell id="notas" value="As colunas de zona não estão no modelo. O motor derivou que a arquitetura afirma redundância zonal (mesmo papel de subnet em ≥2 AZs) e desenhou as faixas — regra do #19, não escolha do agente.&lt;br&gt;Serviços em subnet privada podem precisar de VPC endpoint — confirmar integrações antes de aprovar." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0B34D;fontColor=#6B4E00;fontSize=11;align=left;verticalAlign=top;spacing=8;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="32" y="1542" width="836" height="70" as="geometry"/>
        </mxCell>
