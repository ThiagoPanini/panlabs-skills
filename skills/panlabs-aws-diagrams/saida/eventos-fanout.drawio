ot;dados&quot;:&quot;volta&quot;,&quot;ordem&quot;:3},{&quot;de&quot;:&quot;nota-fiscal&quot;,&quot;para&quot;:&quot;dlq-fiscal&quot;,&quot;rotulo&quot;:&quot;após 3 tentativas&quot;,&quot;ordem&quot;:4},{&quot;de&quot;:&quot;barramento&quot;,&quot;para&quot;:&quot;fila-estoque&quot;,&quot;rotulo&quot;:&quot;regra de estoque&quot;,&quot;ordem&quot;:5},{&quot;de&quot;:&quot;fila-estoque&quot;,&quot;para&quot;:&quot;baixa-estoque&quot;,&quot;rotulo&quot;:&quot;consome&quot;,&quot;dados&quot;:&quot;volta&quot;,&quot;ordem&quot;:6},{&quot;de&quot;:&quot;baixa-estoque&quot;,&quot;para&quot;:&quot;dlq-estoque&quot;,&quot;rotulo&quot;:&quot;após 3 tentativas&quot;,&quot;ordem&quot;:7},{&quot;de&quot;:&quot;barramento&quot;,&quot;para&quot;:&quot;fila-fidelidade&quot;,&quot;rotulo&quot;:&quot;regra de fidelidade&quot;,&quot;ordem&quot;:8},{&quot;de&quot;:&quot;fila-fidelidade&quot;,&quot;para&quot;:&quot;pontos&quot;,&quot;rotulo&quot;:&quot;consome&quot;,&quot;dados&quot;:&quot;volta&quot;,&quot;ordem&quot;:9},{&quot;de&quot;:&quot;pontos&quot;,&quot;para&quot;:&quot;ledger&quot;,&quot;rotulo&quot;:&quot;credita&quot;,&quot;ordem&quot;:10}],&quot;notas&quot;:[{&quot;id&quot;:&quot;nota-dlq&quot;,&quot;texto&quot;:&quot;Creditar pontos não tem fila morta, e isso é deliberado no modelo: o corpus precisa de um caso em que a regra de assíncrono-sem-DLQ tenha o que dizer, ao lado de dois consumidores em que ela tem de ficar calada.&quot;,&quot;origem&quot;:&quot;legenda&quot;}],&quot;dossie&quot;:{&quot;_comentario&quot;:&quot;T3 do corpus do #26. O leque assíncrono é o que dá à revisão de lacunas um sujeito real: três caminhos por fila, dois com destino de falha declarado e um sem.&quot;,&quot;eixos&quot;:{&quot;E1&quot;:&quot;gerenciado sem compute próprio&quot;,&quot;E2&quot;:&quot;assíncrono por evento&quot;,&quot;E3&quot;:&quot;chave-valor para saldo, fila para trânsito&quot;,&quot;E4&quot;:&quot;sem exposição de rede própria&quot;,&quot;E5&quot;:&quot;fronteira única: pagamentos&quot;}}}" panlabsTema="{&quot;id&quot;:&quot;claro&quot;,&quot;fundo&quot;:&quot;claro&quot;,&quot;tokens&quot;:{&quot;pagina&quot;:{&quot;cor&quot;:&quot;#FFFFFF&quot;,&quot;margem&quot;:32},&quot;grupo&quot;:{&quot;tingimento&quot;:&quot;derivado&quot;},&quot;tinta&quot;:{&quot;forte&quot;:&quot;#232F3E&quot;,&quot;fraca&quot;:&quot;#5A6C86&quot;,&quot;halo&quot;:&quot;#FFFFFF&quot;},&quot;texto&quot;:{&quot;familia&quot;:&quot;Arial,Helvetica&quot;,&quot;rotulo&quot;:12,&quot;grupo&quot;:12,&quot;aresta&quot;:10,&quot;titulo&quot;:19,&quot;subtitulo&quot;:12,&quot;qualificador&quot;:false},&quot;aresta&quot;:{&quot;cor&quot;:&quot;#232F3E&quot;,&quot;espessura&quot;:1.6,&quot;ponta&quot;:&quot;blockThin&quot;,&quot;cantos&quot;:12,&quot;saltos&quot;:&quot;arc&quot;,&quot;fluxo&quot;:&quot;solido&quot;},&quot;folga&quot;:{&quot;base&quot;:8,&quot;densidade&quot;:1},&quot;nota&quot;:{&quot;fundo&quot;:&quot;#FFF8E1&quot;,&quot;borda&quot;:&quot;#B7791F&quot;,&quot;tinta&quot;:&quot;#6B4E00&quot;},&quot;bloco&quot;:{&quot;fundo&quot;:&quot;#FFFFFF&quot;,&quot;borda&quot;:&quot;#232F3E&quot;,&quot;cantos&quot;:12},&quot;cartao&quot;:{&quot;revisao&quot;:null},&quot;fundo&quot;:&quot;claro&quot;}}">
