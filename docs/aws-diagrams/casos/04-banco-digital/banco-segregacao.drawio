ing&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;conta&quot;,&quot;conta&quot;:&quot;200000000001&quot;,&quot;ou&quot;:&quot;Workloads&quot;,&quot;rotulo&quot;:&quot;Transacional&quot;,&quot;qualificador&quot;:&quot;core banking — o caminho quente&quot;}},{&quot;id&quot;:&quot;f-analitico&quot;,&quot;rotulo&quot;:&quot;Analítico e regulatório&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;grupo&quot;,&quot;nota&quot;:&quot;dono: risco e compliance&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;conta&quot;,&quot;conta&quot;:&quot;200000000002&quot;,&quot;ou&quot;:&quot;Workloads&quot;,&quot;rotulo&quot;:&quot;Analítico e regulatório&quot;,&quot;qualificador&quot;:&quot;risco e CADOC&quot;}},{&quot;id&quot;:&quot;f-auditoria&quot;,&quot;rotulo&quot;:&quot;Auditoria&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;grupo&quot;,&quot;nota&quot;:&quot;dono: auditoria interna — ninguém de fora escreve aqui&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;conta&quot;,&quot;conta&quot;:&quot;200000000003&quot;,&quot;ou&quot;:&quot;Security&quot;,&quot;rotulo&quot;:&quot;Auditoria&quot;,&quot;qualificador&quot;:&quot;escrita só de dentro; leitura só pela auditoria&quot;}},{&quot;id&quot;:&quot;abrir-conta&quot;,&quot;rotulo&quot;:&quot;Abertura de conta&quot;,&quot;dentro&quot;:&quot;f-transacional&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;bloco&quot;,&quot;nota&quot;:&quot;KYC e prova de vida&quot;,&quot;qualificador&quot;:&quot;onde o CPF vira cliente&quot;},&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;step functions&quot;,&quot;rotulo&quot;:&quot;Step Functions · KYC&quot;,&quot;qualificador&quot;:&quot;prova de vida e bureau&quot;}},{&quot;id&quot;:&quot;movimentar&quot;,&quot;rotulo&quot;:&quot;Movimentação&quot;,&quot;dentro&quot;:&quot;f-transacional&quot;,&quot;logico&quot;:{&quot;tipo&quot;:&quot;bloco&quot;,&quot;nota&quot;:&quot;Pix, TED, boleto&quot;,&quot;qualificador&quot;:&quot;o caminho quente — 2,1 m