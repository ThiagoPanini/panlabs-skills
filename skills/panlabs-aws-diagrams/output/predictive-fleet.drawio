        <object id="panlabs-modelo" label="" panlabsSchema="panlabs-aws-diagrams/session@1" panlabsVista="technical" panlabsSemantica="sha256:cad77e66a1f3c6b0e3555943a911654df84d22bf1783cdd96b4adbbf7c0ccc1c" panlabsAparencia="sha256:afaec2552b6f62634a552c61a567215f7d5b787cd6f8bdc1237b90d792b15aa6" panlabsMotor="panlabs-aws-diagrams/engine@1" panlabsSessao="{&quot;schema&quot;:&quot;panlabs-aws-diagrams/session@1&quot;,&quot;id&quot;:&quot;predictive-fleet&quot;,&quot;title&quot;:&quot;Frota · manutenção preditiva&quot;,&quot;stage&quot;:&quot;technical&quot;,&quot;vistas&quot;:{&quot;logical&quot;:{&quot;genre&quot;:&quot;L2&quot;,&quot;title&quot;:&quot;Frota · manutenção preditiva · vista lógica&quot;,&quot;subtitle&quot;:&quot;Capacidades e fronteiras de responsabilidade — zero nome de serviço AWS. O caso ponta a ponta do #26.&quot;},&quot;technical&quot;:{&quot;genre&quot;:&quot;T3&quot;,&quot;title&quot;:&quot;Frota · manutenção preditiva · vista técnica&quot;,&quot;subtitle&quot;:&quot;T3 event-driven · a MESMA vista aprovada, agora com serviços AWS e um nível de rede que a lógica não tem.&quot;}},&quot;nodes&quot;:[{&quot;id&quot;:&quot;veiculo&quot;,&quot;label&quot;:&quot;Caminhões&quot;,&quot;logical&quot;:{&quot;kind&quot;:&quot;actor&quot;,&quot;note&quot;:&quot;1.200 veículos, telemetria a cada 30 s&quot;},&quot;technical&quot;:{&quot;kind&quot;:&quot;actor&quot;,&quot;service&quot;:&quot;users&quot;,&quot;label&quot;:&quot;Caminhões&quot;}},{&quot;id&quot;:&quot;oficina&quot;,&quot;label&quot;:&quot;Oficinas&quot;,&quot;logical&quot;:{&quot;kind&quot;:&quot;actor&quot;,&quot;note&quot;:&quot;34 pontos próprios&quot;},&quot;technical&quot;:{&quot;kind&quot;:&quot;actor&quot;,&quot;service&quot;:&quot;users&quot;,&quot;label&quot;:&quot;Oficinas&quot;}},{&quot;id&quot;:&quot;coleta&quot;,&quot;label&quot;:&quot;Coleta&quot;,&quot;logical&quot;:{&quot;kind&quot;:&quot;group&quot;,&quot;note&quot;:&quot;dono: engenharia embarcada&quot;},&quot;technical&quo