        <object id="panlabs-modelo" label="" panlabsEsquema="panlabs-aws-diagrams/modelo@1" panlabsModelo="{&quot;esquema&quot;:&quot;panlabs-aws-diagrams/modelo@1&quot;,&quot;id&quot;:&quot;pedidos-serverless&quot;,&quot;titulo&quot;:&quot;Pedidos · API serverless com catálogo relacional&quot;,&quot;subtitulo&quot;:&quot;Vista técnica T1 · us-east-1 · o exemplo que o ticket #11 pediu, escrito só com semântica&quot;,&quot;vista&quot;:&quot;tecnica&quot;,&quot;genero&quot;:&quot;T1&quot;,&quot;nos&quot;:[{&quot;id&quot;:&quot;cliente&quot;,&quot;tipo&quot;:&quot;ator&quot;,&quot;servico&quot;:&quot;users&quot;,&quot;rotulo&quot;:&quot;Clientes&quot;},{&quot;id&quot;:&quot;nuvem&quot;,&quot;tipo&quot;:&quot;nuvem&quot;,&quot;rotulo&quot;:&quot;AWS Cloud&quot;},{&quot;id&quot;:&quot;regiao&quot;,&quot;tipo&quot;:&quot;regiao&quot;,&quot;rotulo&quot;:&quot;us-east-1&quot;,&quot;dentro&quot;:&quot;nuvem&quot;},{&quot;id&quot;:&quot;apigw&quot;,&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;api gateway&quot;,&quot;rotulo&quot;:&quot;API Gateway&quot;,&quot;dentro&quot;:&quot;regiao&quot;},{&quot;id&quot;:&quot;ddb&quot;,&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;dynamodb&quot;,&quot;rotulo&quot;:&quot;DynamoDB&quot;,&quot;dentro&quot;:&quot;regiao&quot;},{&quot;id&quot;:&quot;vpc&quot;,&quot;tipo&quot;:&quot;vpc&quot;,&quot;rotulo&quot;:&quot;VPC de aplicação · 10.0.0.0/16&quot;,&quot;cidr&quot;:&quot;10.0.0.0/16&quot;,&quot;dentro&quot;:&quot;regiao&quot;},{&quot;id&quot;:&quot;sub-priv&quot;,&quot;tipo&quot;:&quot;subnet&quot;,&quot;rotulo&quot;:&quot;Private subnet&quot;,&quot;acesso&quot;:&quot;privada&quot;,&quot;az&quot;:&quot;us-east-1a&quot;,&quot;cidr&quot;:&quot;10.0.1.0/24&quot;,&quot;dentro&quot;:&quot;vpc&quot;},{&quot;id&quot;:&quot;lambda&quot;,&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;lambda&quot;,&quot;rotulo&quot;:&quot;Processar pedido&quot;,&quot;dentro&quot;:&quot;sub-priv&quot;},{&quot;id&quot;:&quot;vpce&quot;,&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;endpoints&quot;,&quot;rotulo&quot;:&quot;VPC endpoint&quot;,&quot;dentro&quot;:&quot;sub-priv&quot;},{&quot;id&quot;:&quot;rds&quot;,&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;rds&quot;,&quot;rotulo&quot;:&quot;Catálogo&quot;,&quot;dentro&quot;:&quot;sub-priv&quot;,&quot;nota&quot;:&quot;single-AZ&quot;}],&quot;arestas&quot;:[{&quot;de&quot;:&quot;cliente&quot;,&quot;para&quot;:&quot;apigw&quot;,&quot;rotulo&quot;:&quot;POST /pedidos&quot;,&quot;protocolo&quot;:&quot;https&quot;,&quot;ordem&quot;:1},{&quot;de&quot;:&quot;apigw&quot;,&quot;para&quot;:&quot;lambda&quot;,&quot;rotulo&quot;:&quot;invoca&quot;,&quot;ordem&quot;:2},{&quot;de&quot;:&quot;lambda&quot;,&quot;para&quot;:&quot;rds&quot;,&quot;rotulo&quot;:&quot;consulta catálogo&quot;,&quot;protocolo&quot;:&quot;sql&quot;,&quot;ordem&quot;:3},{&quot;de&quot;:&quot;lambda&quot;,&quot;para&quot;:&quot;vpce&quot;,&quot;rotulo&quot;:&quot;grava pedido&quot;,&quot;ordem&quot;:4},{&quot;de&quot;:&quot;vpce&quot;,&quot;para&quot;:&quot;ddb&quot;,&quot;rotulo&quot;:&quot;sem sair da rede AWS&quot;,&quot;ordem&quot;:5}],&quot;notas&quot;:[{&quot;id&quot;:&quot;nota-spof&quot;,&quot;texto&quot;:&quot;RDS em AZ única: ponto único de falha conhecido. O time aceitou para o piloto e vai revisar antes do go-live.&quot;,&quot;origem&quot;:&quot;achado-recusado&quot;}],&quot;dossie&quot;:{&quot;_comentario&quot;:&quot;OPACO AO MOTOR. Existe aqui para provar que o dossiê da sabatina (#15) viaja junto e volta intacto do .drawio, sem que o motor leia um único campo.&quot;,&quot;eixos&quot;:{&quot;E1&quot;:&quot;serverless gerenciado&quot;,&quot;E2&quot;:&quot;síncrono request/response&quot;,&quot;E3&quot;:&quot;relacional para catálogo, chave-valor para pedido&quot;,&quot;E4&quot;:&quot;exposto por API pública, dado em subnet privada&quot;,&quot;E5&quot;:&quot;conta única&quot;},&quot;candidatas&quot;:[{&quot;nome&quot;:&quot;Serverless puro&quot;,&quot;tupla&quot;:[&quot;serverless&quot;,&quot;sincrono&quot;,&quot;misto&quot;,&quot;publica&quot;,&quot;conta-unica&quot;],&quot;escolhida&quot;:true},{&quot;nome&quot;:&quot;Containers no ECS&quot;,&quot;tupla&quot;:[&quot;container&quot;,&quot;sincrono&quot;,&quot;misto&quot;,&quot;publica&quot;,&quot;conta-unica&quot;],&quot;escolhida&quot;:false,&quot;difereEm&quot;:&quot;E1&quot;}],&quot;fatos&quot;:[{&quot;fato&quot;:&quot;300 pedidos por minuto no pico&quot;,&quot;procedencia&quot;:&quot;perguntado&quot;,&quot;confirmado&quot;:true},{&quot;fato&quot;:&quot;catálogo já vive em Postgres&quot;,&quot;procedencia&quot;:&quot;perguntado&quot;,&quot;confirmado&quot;:true},{&quot;fato&quot;:&quot;sem requisito de multi-região&quot;,&quot;procedencia&quot;:&quot;inferido&quot;,&quot;confirmado&quot;:true}],&quot;estacionamento&quot;:[&quot;o usuário disse &#39;Lambda&#39; no primeiro minuto — voltou na fase técnica, confirmado&quot;],&quot;achados&quot;:[{&quot;regra&quot;:&quot;spof&quot;,&quot;alvo&quot;:&quot;rds&quot;,&quot;estado&quot;:&quot;recusado&quot;,&quot;nota&quot;:&quot;aceito para o piloto&quot;},{&quot;regra&quot;:&quot;egress-sem-controle&quot;,&quot;alvo&quot;:&quot;sub-priv&quot;,&quot;estado&quot;:&quot;resolvido&quot;,&quot;nota&quot;:&quot;VPC endpoint em vez de NAT&quot;}]}}">
