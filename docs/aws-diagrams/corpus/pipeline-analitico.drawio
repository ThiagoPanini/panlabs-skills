        <object id="panlabs-modelo" label="" panlabsEsquema="panlabs-aws-diagrams/modelo@1" panlabsModelo="{&quot;esquema&quot;:&quot;panlabs-aws-diagrams/modelo@1&quot;,&quot;id&quot;:&quot;pipeline-analitico&quot;,&quot;titulo&quot;:&quot;Telemetria de loja · pipeline analítico&quot;,&quot;subtitulo&quot;:&quot;Vista técnica T2 · cadeia de serviços gerenciados fora de VPC — nenhuma sub-rede, nenhum andar de rede a ler&quot;,&quot;vista&quot;:&quot;tecnica&quot;,&quot;genero&quot;:&quot;T2&quot;,&quot;nos&quot;:[{&quot;id&quot;:&quot;loja&quot;,&quot;tipo&quot;:&quot;ator&quot;,&quot;servico&quot;:&quot;users&quot;,&quot;rotulo&quot;:&quot;Lojas&quot;,&quot;qualificador&quot;:&quot;300 pontos de venda&quot;},{&quot;id&quot;:&quot;nuvem&quot;,&quot;tipo&quot;:&quot;nuvem&quot;,&quot;rotulo&quot;:&quot;AWS Cloud&quot;},{&quot;id&quot;:&quot;regiao&quot;,&quot;tipo&quot;:&quot;regiao&quot;,&quot;rotulo&quot;:&quot;sa-east-1&quot;,&quot;dentro&quot;:&quot;nuvem&quot;},{&quot;id&quot;:&quot;ingestao&quot;,&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;kinesis data firehose&quot;,&quot;rotulo&quot;:&quot;Data Firehose&quot;,&quot;dentro&quot;:&quot;regiao&quot;,&quot;qualificador&quot;:&quot;recebe e entrega em lotes de 5 min&quot;},{&quot;id&quot;:&quot;bruto&quot;,&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;s3&quot;,&quot;rotulo&quot;:&quot;Zona bruta&quot;,&quot;dentro&quot;:&quot;regiao&quot;,&quot;qualificador&quot;:&quot;particionado por dia e loja&quot;},{&quot;id&quot;:&quot;catalogo&quot;,&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;glue&quot;,&quot;rotulo&quot;:&quot;Glue&quot;,&quot;dentro&quot;:&quot;regiao&quot;,&quot;qualificador&quot;:&quot;cataloga e transforma&quot;},{&quot;id&quot;:&quot;curado&quot;,&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;s3&quot;,&quot;rotulo&quot;:&quot;Zona curada&quot;,&quot;dentro&quot;:&quot;regiao&quot;,&quot;qualificador&quot;:&quot;colunar, pronto para consulta&quot;},{&quot;id&quot;:&quot;consulta&quot;,&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;athena&quot;,&quot;rotulo&quot;:&quot;Athena&quot;,&quot;dentro&quot;:&quot;regiao&quot;,&quot;qualificador&quot;:&quot;SQL sobre a zona curada&quot;},{&quot;id&quot;:&quot;painel&quot;,&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;quicksight&quot;,&quot;rotulo&quot;:&quot;QuickSight&quot;,&quot;dentro&quot;:&quot;regiao&quot;,&quot;qualificador&quot;:&quot;painel de vendas por região&quot;}],&quot;arestas&quot;:[{&quot;de&quot;:&quot;loja&quot;,&quot;para&quot;:&quot;ingestao&quot;,&quot;rotulo&quot;:&quot;envia telemetria&quot;,&quot;protocolo&quot;:&quot;https&quot;,&quot;ordem&quot;:1},{&quot;de&quot;:&quot;ingestao&quot;,&quot;para&quot;:&quot;bruto&quot;,&quot;rotulo&quot;:&quot;entrega em lote&quot;,&quot;ordem&quot;:2},{&quot;de&quot;:&quot;catalogo&quot;,&quot;para&quot;:&quot;bruto&quot;,&quot;rotulo&quot;:&quot;lê e cataloga&quot;,&quot;dados&quot;:&quot;volta&quot;,&quot;ordem&quot;:3},{&quot;de&quot;:&quot;catalogo&quot;,&quot;para&quot;:&quot;curado&quot;,&quot;rotulo&quot;:&quot;grava colunar&quot;,&quot;ordem&quot;:4},{&quot;de&quot;:&quot;consulta&quot;,&quot;para&quot;:&quot;curado&quot;,&quot;rotulo&quot;:&quot;consulta&quot;,&quot;protocolo&quot;:&quot;sql&quot;,&quot;dados&quot;:&quot;volta&quot;,&quot;ordem&quot;:5},{&quot;de&quot;:&quot;painel&quot;,&quot;para&quot;:&quot;consulta&quot;,&quot;rotulo&quot;:&quot;renderiza&quot;,&quot;dados&quot;:&quot;volta&quot;,&quot;ordem&quot;:6}],&quot;notas&quot;:[{&quot;id&quot;:&quot;nota-sem-rede&quot;,&quot;texto&quot;:&quot;Nenhum serviço desta cadeia vive em sub-rede — é o gênero T2 em estado puro, e o caminho do ELK layouta a hierarquia inteira numa passada. Não há andar de rede a ordenar porque não há sub-rede.&quot;,&quot;origem&quot;:&quot;legenda&quot;}],&quot;dossie&quot;:{&quot;_comentario&quot;:&quot;T2 do corpus do #26. Existe para provar que o gênero pipeline de dados atravessa o motor sem passar por VPC nenhuma, e para dar à revisão de lacunas um caso onde a regra de sub-rede pública TEM de ficar muda.&quot;,&quot;eixos&quot;:{&quot;E1&quot;:&quot;gerenciado sem compute próprio&quot;,&quot;E2&quot;:&quot;lote agendado, com entrega por janela&quot;,&quot;E3&quot;:&quot;objeto / data lake com camada analítica&quot;,&quot;E4&quot;:&quot;sem exposição de rede própria — tudo por endpoint gerenciado&quot;,&quot;E5&quot;:&quot;fronteira única: plataforma de dados&quot;}}}" panlabsTema="{&quot;id&quot;:&quot;claro&quot;,&quot;fundo&quot;:&quot;claro&quot;,&quot;tokens&quot;:{&quot;pagina&quot;:{&quot;cor&quot;:&quot;#FFFFFF&quot;,&quot;margem&quot;:32},&quot;grupo&quot;:{&quot;tingimento&quot;:&quot;derivado&quot;},&quot;tinta&quot;:{&quot;forte&quot;:&quot;#232F3E&quot;,&quot;fraca&quot;:&quot;#5A6C86&quot;,&quot;halo&quot;:&quot;#FFFFFF&quot;},&quot;texto&quot;:{&quot;familia&quot;:&quot;Arial,Helvetica&quot;,&quot;rotulo&quot;:12,&quot;grupo&quot;:12,&quot;aresta&quot;:10,&quot;titulo&quot;:19,&quot;subtitulo&quot;:12,&quot;qualificador&quot;:false},&quot;aresta&quot;:{&quot;cor&quot;:&quot;#232F3E&quot;,&quot;espessura&quot;:1.6,&quot;ponta&quot;:&quot;blockThin&quot;,&quot;cantos&quot;:12,&quot;saltos&quot;:&quot;arc&quot;,&quot;fluxo&quot;:&quot;solido&quot;},&quot;folga&quot;:{&quot;base&quot;:8,&quot;densidade&quot;:1},&quot;nota&quot;:{&quot;fundo&quot;:&quot;#FFF8E1&quot;,&quot;borda&quot;:&quot;#B7791F&quot;,&quot;tinta&quot;:&quot;#6B4E00&quot;},&quot;bloco&quot;:{&quot;fundo&quot;:&quot;#FFFFFF&quot;,&quot;borda&quot;:&quot;#232F3E&quot;,&quot;cantos&quot;:12},&quot;cartao&quot;:{&quot;revisao&quot;:null},&quot;fundo&quot;:&quot;claro&quot;}}">
