;:&quot;Pontuação de risco&quot;,&quot;inside&quot;:&quot;sub-modelo&quot;,&quot;logical&quot;:{&quot;kind&quot;:&quot;block&quot;,&quot;note&quot;:&quot;modelo treinado, roda por veículo&quot;},&quot;technical&quot;:{&quot;kind&quot;:&quot;service&quot;,&quot;service&quot;:&quot;sagemaker&quot;,&quot;label&quot;:&quot;SageMaker · endpoint de inferência&quot;}},{&quot;id&quot;:&quot;abrir-ordem&quot;,&quot;label&quot;:&quot;Abertura de ordem&quot;,&quot;inside&quot;:&quot;acao&quot;,&quot;logical&quot;:{&quot;kind&quot;:&quot;block&quot;,&quot;note&quot;:&quot;só acima do corte de risco&quot;},&quot;technical&quot;:{&quot;kind&quot;:&quot;service&quot;,&quot;service&quot;:&quot;step functions&quot;,&quot;label&quot;:&quot;Step Functions · abertura de ordem&quot;}},{&quot;id&quot;:&quot;avisar-oficina&quot;,&quot;label&quot;:&quot;Aviso à oficina&quot;,&quot;inside&quot;:&quot;acao&quot;,&quot;logical&quot;:{&quot;kind&quot;:&quot;block&quot;,&quot;note&quot;:&quot;canal único, com confirmação&quot;},&quot;technical&quot;:{&quot;kind&quot;:&quot;service&quot;,&quot;service&quot;:&quot;sns&quot;,&quot;label&quot;:&quot;SNS · tópico de alerta&quot;}},{&quot;id&quot;:&quot;cloud&quot;,&quot;layer&quot;:&quot;technical&quot;,&quot;technical&quot;:{&quot;kind&quot;:&quot;cloud&quot;,&quot;label&quot;:&quot;AWS Cloud&quot;}},{&quot;id&quot;:&quot;vpc-modelo&quot;,&quot;layer&quot;:&quot;technical&quot;,&quot;inside&quot;:&quot;analise&quot;,&quot;technical&quot;:{&quot;kind&quot;:&quot;vpc&quot;,&quot;label&quot;:&quot;VPC de inferência · 10.30.0.0/16&quot;,&quot;cidr&quot;:&quot;10.30.0.0/16&quot;}},{&quot;id&quot;:&quot;sub-modelo&quot;,&quot;layer&quot;:&quot;technical&quot;,&quot;inside&quot;:&quot;vpc-modelo&quot;,&quot;technical&quot;:{&quot;kind&quot;:&quot;subnet&quot;,&quot;label&quot;:&quot;Private subnet&quot;,&quot;access&quot;:&quot;private&quot;,&quot;cidr&quot;:&quot;10.30.1.0/24&quot;}},{&quot;id&quot;:&quot;endpoint-s3&quot;,&quot;layer&quot;:&quot;technical&quot;,&quot;inside&quot;:&quot;sub-modelo&quot;,&quot;technical&quot;:{&quot;kind&quot;:&quot;service&quot;,&quot;service&quot;:&quot;endpoints&quot;,&quot;label&quot;:&quot;VPC endpoint (S3)&quot;}}],&quot;edges&quot;:[{&quot;id&quot;:&quot;a-envia&quot;,&quot;from&quot;:&quot;veiculo&quot;,&quot;to&quot;:&quot;receber-telemetria&quot;,&quot;label&quot;:&quot;envia telemetria&quot;,&quot;order&quot;:1,&quot;technical&quot;:{&quot;label&quot;:&quot;PutRecord · 30 s&quot;}},{&quot;id&quot;:&quot;a-grava&quot;,&quot;from&quot;:&quot;receber-telemetria&quot;,&quot;to&quot;:&quot;guardar-serie&quot;,&quot;label&quot;:&quot;grava a série&quot;,&quot;order&quot;:2},{&quot;id&quot;:&quot;a-le&quot;,&quot;from&quot;:&quot;detectar-anomalia&quot;,&quot;to&quot;:&quot;guardar-serie&quot;,&quot;label&quot;:&quot;lê a janela&quot;,&quot;data&quot;:&quot;back&quot;,&quot;order&quot;:3,&quot;technical&quot;:{&quot;label&quot;:&quot;consulta a janela de 24 h&quot;}},{&quot;id&quot;:&quot;a-pontua&quot;,&quot;from&quot;:&quot;detectar-anomalia&quot;,&quot;to&quot;:&quot;pontuar-risco&quot;,&quot;label&quot;:&quot;anomalia encontrada&quot;,&quot;order&quot;:4},{&quot;id&quot;:&quot;a-abre&quot;,&quot;from&quot;:&quot;pontuar-risco&quot;,&quot;to&quot;:&quot;abrir-ordem&quot;,&quot;label&quot;:&quot;risco acima do corte&quot;,&quot;order&quot;:5},{&quot;id&quot;:&quot;a-avisa&quot;,&quot;from&quot;:&quot;abrir-ordem&quot;,&quot;to&quot;:&quot;avisar-oficina&quot;,&quot;label&quot;:&quot;ordem aberta&quot;,&quot;order&quot;:6},{&quot;id&quot;:&quot;a-alerta&quot;,&quot;from&quot;:&quot;avisar-oficina&quot;,&quot;to&quot;:&quot;oficina&quot;,&quot;label&quot;:&quot;alerta com prazo&quot;,&quot;order&quot;:7},{&quot;id&quot;:&quot;a-artefato&quot;,&quot;from&quot;:&quot;pontuar-risco&quot;,&quot;to&quot;:&quot;endpoint-s3&quot;,&quot;layer&quot;:&quot;technical&quot;,&quot;label&quot;:&quot;carrega o artefato do modelo&quot;,&quot;data&quot;:&quot;back&quot;}],&quot;notes&quot;:[{&quot;id&quot;:&quot;n-fronteira&quot;,&quot;origin&quot;:&quot;assumption&quot;,&quot;text&quot;:&quot;Os três grupos são fronteiras de RESPONSABILIDADE, não contas AWS (#15 §6). Esta vista foi a que a diretoria aprovou.&quot;},{&quot;id&quot;:&quot;n-spof&quot;,&quot;origin&quot;:&quot;rejected-finding&quot;,&quot;about&quot;:&quot;receber-telemetria&quot;,&quot;text&quot;:&quot;Ponto único de recepção conhecido e aceito: um caminho de entrada só, sem par. A fleet tolera 30 min de buffer no veículo, e o time aceitou para a fase 1 (2026-08).&quot;},{&quot;id&quot;:&quot;n-buffer&quot;,&quot;layer&quot;:&quot;technical&quot;,&quot;origin&quot;:&quot;assumption&quot;,&quot;text&quot;:&quot;Retenção de 24 h no fluxo: cobre os 30 min de buffer do veículo com folga, e é o que sustenta o SPOF aceito na recepção.&quot;}],&quot;dossier&quot;:{&quot;facts&quot;:[{&quot;fact&quot;:&quot;1.200 veículos, telemetria a cada 30 s&quot;,&quot;provenance&quot;:&quot;asked&quot;,&quot;confirmed&quot;:true},{&quot;fact&quot;:&quot;o caminhão guarda 30 min de leitura se perder o link&quot;,&quot;provenance&quot;:&quot;asked&quot;,&quot;confirmed&quot;:true},{&quot;fact&quot;:&quot;a oficina precisa de 48 h de antecedência para agendar&quot;,&quot;provenance&quot;:&quot;asked&quot;,&quot;confirmed&quot;:true},{&quot;fact&quot;:&quot;hoje a manutenção é por quilometragem, não por condição&quot;,&quot;provenance&quot;:&quot;asked&quot;,&quot;confirmed&quot;:true},{&quot;fact&quot;:&quot;não há requisito de multi-região&quot;,&quot;provenance&quot;:&quot;inferred&quot;,&quot;confirmed&quot;:true,&quot;from&quot;:&quot;\&quot;a operação é só Brasil\&quot;, na ata da reunião de 12/08&quot;},{&quot;fact&quot;:&quot;a série tem de durar dois anos para treinar o modelo&quot;,&quot;provenance&quot;:&quot;inferred&quot;,&quot;confirmed&quot;:true,&quot;from&quot;:&quot;\&quot;o pessoal de dados falou em dois ciclos de revisão\&quot;&quot;}],&quot;candidates&quot;:[{&quot;id&quot;:&quot;cand-a&quot;,&quot;name&quot;:&quot;Fluxo contínuo com pontuação por veículo&quot;,&quot;state&quot;:&quot;chosen&quot;,&quot;tuple&quot;:[&quot;gerenciado-sem-compute&quot;,&quot;evento&quot;,&quot;serie-temporal&quot;,&quot;privado&quot;,&quot;tres-fronteiras&quot;],&quot;buys&quot;:&quot;o alerta sai minutos depois da leitura, que é o que a antecedência de 48 h exige&quot;,&quot;pays&quot;:&quot;custo por evento, e um modelo que precisa ser retreinado&quot;,&quot;chooseIf&quot;:&quot;a antecedência importa mais que o custo por leitura&quot;,&quot;wrongIf&quot;:&quot;a fleet crescer para dezenas de milhares e o custo por evento dominar&quot;},{&quot;id&quot;:&quot;cand-b&quot;,&quot;name&quot;:&quot;Lote noturno sobre a série&quot;,&quot;state&quot;:&quot;discarded&quot;,&quot;tuple&quot;:[&quot;gerenciado-sem-compute&quot;,&quot;lote-agendado&quot;,&quot;serie-temporal&quot;,&quot;privado&quot;,&quot;tres-fronteiras&quot;],&quot;differsIn&quot;:[&quot;E2&quot;],&quot;buys&quot;:&quot;custo muito menor e operação mais simples&quot;,&quot;pays&quot;:&quot;até 24 h de atraso entre a leitura e o alerta&quot;,&quot;chooseIf&quot;:&quot;48 h de antecedência forem folgadas&quot;,&quot;wrongIf&quot;:&quot;a falha se desenvolver em menos de um dia&quot;,&quot;because&quot;:&quot;a antecedência de 48 h não sobrevive a um atraso de até 24 h — sobra meio dia para a oficina agendar, e o fato perguntado diz que não dá.&quot;},{&quot;id&quot;:&quot;cand-c&quot;,&quot;name&quot;:&quot;Pontuação no próprio veículo&quot;,&quot;state&quot;:&quot;discarded&quot;,&quot;tuple&quot;:[&quot;computacao-na-borda&quot;,&quot;evento&quot;,&quot;serie-temporal&quot;,&quot;hibrido&quot;,&quot;duas-fronteiras&quot;],&quot;differsIn&quot;:[&quot;E1&quot;,&quot;E4&quot;,&quot;E5&quot;],&quot;buys&quot;:&quot;funciona sem link, e manda só o alerta em vez da série inteira&quot;,&quot;pays&quot;:&quot;atualizar modelo em 1.200 veículos, e perder a série que treina o próximo&quot;,&quot;chooseIf&quot;:&quot;a conectividade for ruim a ponto de a série não chegar&quot;,&quot;wrongIf&quot;:&quot;for preciso retreinar com frequência&quot;,&quot;because&quot;:&quot;o fato de que a série tem de durar dois anos para treinar mata a variante: pontuar na borda e não trazer a leitura joga fora exatamente o insumo do modelo.&quot;}],&quot;findings&quot;:[{&quot;rule&quot;:&quot;spof&quot;,&quot;target&quot;:&quot;receber-telemetria&quot;,&quot;state&quot;:&quot;rejected&quot;,&quot;at&quot;:&quot;2026-08-23&quot;,&quot;viaNote&quot;:&quot;n-spof&quot;,&quot;note&quot;:&quot;sem par, e é o único caminho do caminhão até 5 outros componentes. Aceito: o veículo tem 30 min de buffer.&quot;},{&quot;rule&quot;:&quot;spof&quot;,&quot;target&quot;:&quot;avisar-oficina&quot;,&quot;state&quot;:&quot;accepted&quot;,&quot;at&quot;:&quot;2026-08-23&quot;,&quot;note&quot;:&quot;o outro extremo da cadeia, visto da oficina: um canal de aviso só. Vira tópico gerenciado na fase técnica, com entrega a múltiplos assinantes — deixa de ser ponto único sem mudar a vista lógica.&quot;}],&quot;parking&quot;:[{&quot;name&quot;:&quot;Kinesis&quot;,&quot;capability&quot;:&quot;receber-telemetria&quot;,&quot;state&quot;:&quot;returned&quot;,&quot;note&quot;:&quot;voltou na fase técnica como sugestão inferida contra a capacidade, e foi confirmado (#15 §5).&quot;},{&quot;name&quot;:&quot;SageMaker&quot;,&quot;capability&quot;:&quot;pontuar-risco&quot;,&quot;state&quot;:&quot;returned&quot;,&quot;note&quot;:&quot;voltou e foi confirmado — é ele que vive dentro da sub-rede privada.&quot;}],&quot;agreement&quot;:{&quot;view&quot;:&quot;logical&quot;,&quot;fingerprint&quot;:&quot;sha256:0fd9f19773be067cfae9cc07437a1c22ae0100d97fab7587bbb53a8a75f4861d&quot;,&quot;snapshot&quot;:{&quot;nodes&quot;:[{&quot;id&quot;:&quot;abrir-ordem&quot;,&quot;kind&quot;:&quot;block&quot;,&quot;label&quot;:&quot;Abertura de ordem&quot;,&quot;inside&quot;:&quot;acao&quot;,&quot;note&quot;:&quot;só acima do corte de risco&quot;},{&quot;id&