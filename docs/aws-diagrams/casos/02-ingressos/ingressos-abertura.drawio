        <mxCell id="notas" value="A fila virtual é requisito de negócio, não de capacidade: o time quer que quem entrou primeiro compre primeiro, e isso não é o que o autoscaling entrega." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#B7791F;fontColor=#6B4E00;fontFamily=Arial,Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;dashed=0;" vertex="1" parent="1">
