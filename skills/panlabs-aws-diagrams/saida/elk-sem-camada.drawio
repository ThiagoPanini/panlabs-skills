        <mxCell id="e-ecs-vpce0" value="https" style="edgeStyle=orthogonalEdgeStyle;html=1;jettySize=auto;orthogonalLoop=1;rounded=1;strokeColor=#232F3E;strokeWidth=1.6;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontFamily=Arial,Helvetica;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;arcSize=12;jumpStyle=arc;jumpSize=6;" edge="1" parent="1" source="ecs" target="vpce">
          <mxGeometry relative="1" as="geometry"/>
