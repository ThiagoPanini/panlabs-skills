        </mxCell>
        <object id="panlabs-modelo" label="" panlabsEsquema="panlabs-aws-diagrams/modelo@1" panlabsModelo="{&quot;esquema&quot;:&quot;panlabs-aws-diagrams/modelo@1&quot;,&quot;id&quot;:&quot;loja-banco-exposto&quot;,&quot;titulo&quot;:&quot;Loja online · banco na sub-rede pública&quot;,&quot;subtitulo&quot;:&quot;Vista técnica T1 · a arquitetura que o consultor tem de saber apontar — desenhada como ela é, não como deveria ser&quot;,&quot;vista&quot;:&quot;tecnica&quot;,&quot;genero&quot;:&quot;T1&quot;,&quot;nos&quot;:[{&quot;id&quot;:&quot;cliente&quot;,&quot;tipo&quot;:&quot;ator&quot;,&quot;servico&quot;:&quot;users&quot;,&quot;rotulo&quot;:&quot;Compradores&quot;},{&quot;id&quot;:&quot;nuvem&quot;,&quot;tipo&quot;:&quot;nuvem&quot;,&quot;rotulo&quot;:&quot;AWS Cloud&quot;},{&quot;id&quot;:&quot;vpc&quot;,&quot;tipo&quot;:&quot;vpc&quot;,&quot;rotulo&quot;:&quot;VPC da loja · 10.1.0.0/16&quot;,&quot;cidr&quot;:&quot;10.1.0.0/16&quot;,&quot;dentro&quot;:&quot;nuvem&quot;},{&quot;id&quot;:&quot;sub-pub&quot;,&quot;tipo&quot;:&quot;subnet&quot;,&quot;rotulo&quot;:&quot;Public subnet&quot;,&quot;acesso&quot;:&quot;publica&quot;,&quot;cidr&quot;:&quot;10.1.0.0/24&quot;,&quot;dentro&quot;:&quot;vpc&quot;},{&quot;id&quot;:&quot;alb&quot;,&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;application load balancer&quot;,&quot;rotulo&quot;:&quot;ALB&quot;,&quot;dentro&quot;:&quot;sub-pub&quot;,&quot;qualificador&quot;:&quot;porta 443, único&quot;},{&quot;id&quot;:&quot;nat&quot;,&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;nat gateway&quot;,&quot;rotulo&quot;:&quot;NAT gateway&quot;,&quot;dentro&quot;:&quot;sub-pub&quot;,&quot;qualificador&quot;:&quot;saída da sub-rede privada&quot;},{&quot;id&quot;:&quot;rds&quot;,&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;rds&quot;,&quot;rotulo&quot;:&quot;Catálogo e pedidos&quot;,&quot;dentro&quot;:&quot;sub-pub&quot;,&quot;qualificador&quot;:&quot;Postgres — herdado da migração de 2019&quot;},{&quot;id&quot;:&quot;sub-priv&quot;,&quot;tipo&quot;:&quot;subnet&quot;,&quot;rotulo&quot;:&quot;App subnet&quot;,&quot;acesso&quot;:&quot;privada&quot;,&quot;cidr&quot;:&quot;10.1.1.0/24&quot;,&quot;dentro&quot;:&quot;vpc&quot;},{&quot;id&quot;:&quot;ec2&quot;,&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;ec2&quot;,&quot;rotulo&quot;:&quot;Aplicação&quot;,&quot;dentro&quot;:&quot;sub-priv&quot;,&quot;qualificador&quot;:&quot;instância única&quot;}],&quot;arestas&quot;:[{&quot;de&quot;:&quot;cliente&quot;,&quot;para&quot;:&quot;alb&quot;,&quot;rotulo&quot;:&quot;compra&quot;,&quot;protocolo&quot;:&quot;https&quot;},{&quot;de&quot;:&quot;alb&quot;,&quot;para&quot;:&quot;ec2&quot;,&quot;rotulo&quot;:&quot;encaminha&quot;},{&quot;de&quot;:&quot;ec2&quot;,&quot;para&quot;:&quot;rds&quot;,&quot;rotulo&quot;:&quot;consulta e grava&quot;,&quot;protocolo&quot;:&quot;sql&quot;},{&quot;de&quot;:&quot;ec2&quot;,&quot;para&quot;:&quot;nat&quot;,&quot;rotulo&quot;:&quot;atualizações e APIs externas&quot;}],&quot;notas&quot;:[{&quot;id&quot;:&quot;nota-como-e&quot;,&quot;texto&quot;:&quot;O banco está na sub-rede PÚBLICA, e o desenho mostra isso. Consertar calado produziria um diagrama bonito de uma arquitetura que não existe — e como não há diferença contra IaC neste escopo, nada a jusante pegaria a diferença.&quot;,&quot;origem&quot;:&quot;premissa&quot;}],&quot;dossie&quot;:{&quot;_comentario&quot;:&quot;O caso do corpus do #26 para a regra `dado-em-subnet-publica`. O critério (docs/corpus.md §4.2, L2) exige que TODA regra dispare em pelo menos um modelo — regra que nunca dispara nunca foi testada. Antes deste modelo, essa era a única das seis sem sujeito no corpus inteiro. Existe também para lembrar o que a skill é: um consultor desenha a arquitetura QUE EXISTE e aponta o problema, em vez de desenhar a que gostaria de ter visto.&quot;,&quot;eixos&quot;:{&quot;E1&quot;:&quot;instâncias próprias&quot;,&quot;E2&quot;:&quot;síncrono request/response&quot;,&quot;E3&quot;:&quot;relacional gerenciado&quot;,&quot;E4&quot;:&quot;borda pública, e mais coisa na borda do que deveria&quot;,&quot;E5&quot;:&quot;fronteira única: a loja&quot;}}}" panlabsTema="{&quot;id&quot;:&quot;claro&quot;,&quot;fundo&quot;:&quot;claro&quot;,&quot;tokens&quot;:{&quot;pagina&quot;:{&quot;cor&quot;:&quot;#FFFFFF&quot;,&quot;margem&quot;:32},&quot;grupo&quot;:{&quot;tingimento&quot;:&quot;derivado&quot;},&quot;tinta&quot;:{&quot;forte&quot;:&quot;#232F3E&quot;,&quot;fraca&quot;:&quot;#5A6C86&quot;,&quot;halo&quot;:&quot;#FFFFFF&quot;},&quot;texto&quot;:{&quot;familia&quot;:&quot;Arial,Helvetica&quot;,&quot;rotulo&quot;:12,&quot;grupo&quot;:12,&quot;aresta&quot;:10,&quot;titulo&quot;:19,&quot;subtitulo&quot;:12,&quot;qualificador&quot;:false},&quot;aresta&quot;:{&quot;cor&quot;:&quot;#232F3E&quot;,&quot;espessura&quot;:1.6,&quot;ponta&quot;:&quot;blockThin&quot;,&quot;cantos&quot;:12,&quot;saltos&quot;:&quot;arc&quot;,&quot;fluxo&quot;:&quot;solido&quot;},&quot;folga&quot;:{&quot;base&quot;:8,&quot;densidade&quot;:1},&quot;nota&quot;:{&quot;fundo&quot;:&quot;#FFF8E1&quot;,&quot;borda&quot;:&quot;#B7791F&quot;,&quot;tinta&quot;:&quot;#6B4E00&quot;},&quot;bloco&quot;:{&quot;fundo&quot;:&quot;#FFFFFF&quot;,&quot;borda&quot;:&quot;#232F3E&quot;,&quot;cantos&quot;:12},&quot;cartao&quot;:{&quot;revisao&quot;:null},&quot;fundo&quot;:&quot;claro&quot;}}">
