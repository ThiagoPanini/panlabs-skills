t;:&quot;sub-modelo&quot;,&quot;tecnico&quot;:{&quot;tipo&quot;:&quot;servico&quot;,&quot;servico&quot;:&quot;endpoints&quot;,&quot;rotulo&quot;:&quot;VPC endpoint (S3)&quot;}}],&quot;arestas&quot;:[{&quot;id&quot;:&quot;a-envia&quot;,&quot;de&quot;:&quot;veiculo&quot;,&quot;para&quot;:&quot;receber-telemetria&quot;,&quot;rotulo&quot;:&quot;envia telemetria&quot;,&quot;ordem&quot;:1,&quot;tecnico&quot;:{&quot;rotulo&quot;:&quot;PutRecord · 30 s&quot;}},{&quot;id&quot;:&quot;a-grava&quot;,&quot;de&quot;:&quot;receber-telemetria&quot;,&quot;para&quot;:&quot;guardar-serie&quot;,&quot;rotulo&quot;:&quot;grava a série&quot;,&quot;ordem&quot;:2},{&quot;id&quot;:&quot;a-le&quot;,&quot;de&quot;:&quot;detectar-anomalia&quot;,&quot;para&quot;:&quot;guardar-serie&quot;,&quot;rotulo&quot;:&quot;lê a janela&quot;,&quot;dados&quot;:&quot;volta&quot;,&quot;ordem&quot;:3,&quot;tecnico&quot;:{&quot;rotulo&quot;:&quot;consulta a janela de 24 h&quot;}},{&quot;id&quot;:&quot;a-pontua&quot;,&quot;de&quot;:&quot;detectar-anomalia&quot;,&quot;para&quot;:&quot;pontuar-risco&quot;,&quot;rotulo&quot;:&quot;anomalia encontrada&quot;,&quot;ordem&quot;:4},{&quot;id&quot;:&quot;a-abre&quot;,&quot;de&quot;:&quot;pontuar-risco&quot;,&quot;para&quot;:&quot;abrir-ordem&quot;,&quot;rotulo&quot;:&quot;risco acima do corte&quot;,&quot;ordem&quot;:5},{&quot;id&quot;:&quot;a-avisa&quot;,&quot;de&quot;:&quot;abrir-ordem&quot;,&quot;para&quot;:&quot;avisar-oficina&quot;,&quot;rotulo&quot;:&quot;ordem aberta&quot;,&quot;ordem&quot;:6},{&quot;id&quot;:&quot;a-alerta&quot;,&quot;de&quot;:&quot;avisar-oficina&quot;,&quot;para&quot;:&quot;oficina&quot;,&quot;rotulo&quot;:&quot;alerta com prazo&quot;,&quot;ordem&quot;:7},{&quot;id&quot;:&quot;a-artefato&quot;,&quot;de&quot;:&quot;pontuar-risco&quot;,&quot;para&quot;:&quot;endpoint-s3&quot;,&quot;camada&quot;:&quot;tecnica&quot;,&quot;rotulo&quot;:&quot;carrega o artefato do modelo&quot;,&quot;dados&quot;:&quot;volta&quot;}],&quot;notas&quot;:[{&quot;id&quot;:&quot;n-fronteira&quot;,&quot;origem&quot;:&quot;premissa&quot;,&quot;texto&quot;:&quot;Os três grupos são fronteiras de RESPONSABILIDADE, não contas AWS (#15 §6). Esta vista foi a que a diretoria aprovou.&quot;},{&quot;id&quot;:&quot;n-spof&quot;,&quot;origem&quot;:&quot;achado-recusado&quot;,&quot;sobre&quot;:&quot;receber-telemetria&quot;,&quot;texto&quot;:&quot;Ponto único de recepção conhecido e aceito: um caminho de entrada só, sem par. A frota tolera 30 min de buffer no veículo, e o time aceitou para a fase 1 (2026-08).&quot;},{&quot;id&quot;:&quot;n-buffer&quot;,&quot;camada&quot;:&quot;tecnica&quot;,&quot;origem&quot;:&quot;premissa&quot;,&quot;texto&quot;:&quot;Retenção de 24 h no fluxo: cobre os 30 min de buffer do veículo com folga, e é o que sustenta o SPOF aceito na recepção.&quot;}],&quot;dossie&quot;:{&quot;fatos&quot;:[{&quot;fato&quot;:&quot;1.200 veículos, telemetria a cada 30 s&quot;,&quot;procedencia&quot;:&quot;perguntado&quot;,&quot;confirmado&quot;:true},{&quot;fato&quot;:&quot;o caminhão guarda 30 min de leitura se perder o link&quot;,&quot;procedencia&quot;:&quot;perguntado&quot;,&quot;confirmado&quot;:true},{&quot;fato&quot;:&quot;a oficina precisa de 48 h de antecedência para agendar&quot;,&quot;procedencia&quot;:&quot;perguntado&quot;,&quot;confirmado&quot;:true},{&quot;fato&quot;:&quot;hoje a manutenção é por quilometragem, não por condição&quot;,&quot;procedencia&quot;:&quot;perguntado&quot;,&quot;confirmado&quot;:true},{&quot;fato&quot;:&quot;não há requisito de multi-região&quot;,&quot;procedencia&quot;:&quot;inferido&quot;,&quot;confirmado&quot;:true,&quot;de&quot;:&quot;\&quot;a operação é só Brasil\&quot;, na ata da reunião de 12/08&quot;},{&quot;fato&quot;:&quot;a série tem de durar dois anos para treinar o modelo&quot;,&quot;procedencia&quot;:&quot;inferido&quot;,&quot;confirmado&quot;:true,&quot;de&quot;:&quot;\&quot;o pessoal de dados falou em dois ciclos de revisão\&quot;&quot;}],&quot;candidatas&quot;:[{&quot;id&quot;:&quot;cand-a&quot;,&quot;nome&quot;:&quot;Fluxo contínuo com pontuação por veículo&quot;,&quot;estado&quot;:&quot;escolhida&quot;,&quot;tupla&quot;:[&quot;gerenciado-sem-compute&quot;,&quot;evento&quot;,&quot;serie-temporal&quot;,&quot;privado&quot;,&quot;tres-fronteiras&quot;],&quot;compra&quot;:&quot;o alerta sai minutos depois da leitura, que é o que a antecedência de 48 h exige&quot;,&quot;paga&quot;:&quot;custo por evento, e um modelo que precisa ser retreinado&quot;,&quot;escolhaSe&quot;:&quot;a antecedência importa mais que o custo por leitura&quot;,&quot;erradaSe&quot;:&quot;a frota crescer para dezenas de milhares e o custo por evento dominar&quot;},{&quot;id&quot;:&quot;cand-b&quot;,&quot;nome&quot;:&quot;Lote noturno sobre a série&quot;,&quot;estado&quot;:&quot;descartada&quot;,&quot;tupla&quot;:[&quot;gerenciado-sem-compute&quot;,&quot;lote-agendado&quot;,&quot;serie-temporal&quot;,&quot;privado&quot;,&quot;tres-fronteiras&quot;],&quot;difereEm&quot;:[&quot;E2&quot;],&quot;compra&quot;:&quot;custo muito menor e operação mais simples&quot;,&quot;paga&quot;:&quot;até 24 h de atraso entre a leitura e o alerta&quot;,&quot;escolhaSe&quot;:&quot;48 h de antecedência forem folgadas&quot;,&quot;erradaSe&quot;:&quot;a falha se desenvolver em menos de um dia&quot;,&quot;porque&quot;:&quot;a antecedência de 48 h não sobrevive a um atraso de até 24 h — sobra meio dia para a oficina agendar, e o fato perguntado diz que não dá.&quot;},{&quot;id&quot;:&quot;cand-c&quot;,&quot;nome&quot;:&quot;Pontuação no próprio veículo&quot;,&quot;estado&quot;:&quot;descartada&quot;,&quot;tupla&quot;:[&quot;computacao-na-borda&quot;,&quot;evento&quot;,&quot;serie-temporal&quot;,&quot;hibrido&quot;,&quot;duas-fronteiras&quot;],&quot;difereEm&quot;:[&quot;E1&quot;,&quot;E4&quot;,&quot;E5&quot;],&quot;compra&quot;:&quot;funciona sem link, e manda só o alerta em vez da série inteira&quot;,&quot;paga&quot;:&quot;atualizar modelo em 1.200 veículos, e perder a série que treina o próximo&quot;,&quot;escolhaSe&quot;:&quot;a conectividade for ruim a ponto de a série não chegar&quot;,&quot;erradaSe&quot;:&quot;for preciso retreinar com frequência&quot;,&quot;porque&quot;:&quot;o fato de que a série tem de durar dois anos para treinar mata a variante: pontuar na borda e não trazer a leitura joga fora exatamente o insumo do modelo.&quot;}],&quot;achados&quot;:[{&quot;regra&quot;:&quot;spof&quot;,&quot;alvo&quot;:&quot;receber-telemetria&quot;,&quot;estado&quot;:&quot;recusado&quot;,&quot;em&quot;:&quot;2026-08-23&quot;,&quot;viaNota&quot;:&quot;n-spof&quot;,&quot;nota&quot;:&quot;sem par, e é o único caminho do caminhão até 5 outros componentes. Aceito: o veículo tem 30 min de buffer.&quot;},{&quot;regra&quot;:&quot;spof&quot;,&quot;alvo&quot;:&quot;avisar-oficina&quot;,&quot;estado&quot;:&quot;aceito&quot;,&quot;em&quot;:&quot;2026-08-23&quot;,&quot;nota&quot;:&quot;o outro extremo da cadeia, visto da oficina: um canal de aviso só. Vira tópico gerenciado na fase técnica, com entrega a múltiplos assinantes — deixa de ser ponto único sem mudar a vista lógica.&quot;}],&quot;estacionamento&quot;:[{&quot;nome&quot;:&quot;Kinesis&quot;,&quot;capacidade&quot;:&quot;receber-telemetria&quot;,&quot;estado&quot;:&quot;devolvido&quot;,&quot;nota&quot;:&quot;voltou na fase técnica como sugestão inferida contra a capacidade, e foi confirmado (#15 §5).&quot;},{&quot;nome&quot;:&quot;SageMaker&quot;,&quot;capacidade&quot;:&quot;pontuar-risco&quot;,&quot;estado&quot;:&quot;devolvido&quot;,&quot;nota&quot;:&quot;voltou e foi confirmado — é ele que vive dentro da sub-rede privada.&quot;}],&quot;acordo&quot;:{&quot;vista&quot;:&quot;logica&quot;,&quot;impressao&quot;:&quot;sha256:29675732a5c7d6c7e79eb7833103f371051401093568c83b2925e7ce8dc802c7&quot;,&quot;recorte&quot;:{&quot;nos&quot;:[{&quot;id&quot;:&quot;abrir-ordem&quot;,&quot;tipo&quot;:&quot;bloco&quot;,&quot;rotulo&quot;:&quot;Abertura de ordem&quot;,&quot;dentro&quot;:&quot;acao&quot;,&quot;nota&quot;:&quot;só acima do corte de risco&quot;},{&quot;id&quot;:&quot;acao&quot;,&quot;tipo&quot;:&quot;grupo&quot;,&quot;rotulo&quot;:&quot;Ação&quot;,&quot;nota&quot;:&quot;dono: operações de frota&quot;},{&quot;id&quot;:&quot;analise&quot;,&quot;tipo&quot;:&quot;grupo&quot;,&quot;rotulo&quot;:&quot;Análise&quot;,&quot;nota&quot;:&quot;dono: time de dados&quot;},{&quot;id&quot;:&quot;avisar-oficina&quot;,&quot;tipo&quot;:&quot;bloco&quot;,&quot;rotulo&quot;:&quot;Aviso à oficina&quot;,&quot;dentro&quot;:&quot;acao&quot;,&quot;nota&quot;:&quot;canal único, com confirmação&quot;},{&quot;id&quot;:&quot;coleta&quot;,&quot;tipo&quot;:&quot;grupo&quot;,&quot;rotulo&quot;:&quot;Coleta&quot;,&quot;nota&quot;:&quot;dono: engenharia embarcada&quot;},{&quot;id&quot;:&quot;detectar-anomalia&quot;,&quot;tipo&quot;:&quot;bloco&quot;,&quot;rotulo&quot;:&quot;Detecção de anomalia&quot;,&quot;dentro&quot;:&quot;analise&quot;,&quot;nota&quot;:&quot;regra simples sobre a janela&quot;},{&quot;id&quot;:&quot;guardar-serie&quot;,&quot;tipo&quot;:&quot;bloco&quot;,&quot;rotulo&quot;:&quot;Série histórica&quot;,&quot;dentro&quot;:&quot;coleta&quot;,&quot;nota&quot;:&quot;dois anos, consultável por veículo&quot;},{&quot;id&quot;:&quot;oficina&quot;,&quot;tipo&quot;:&quot;ator&quot;,&quot;rotulo&quot;:&quot;Oficinas&quot;,&quot;nota&quot;:&quot;34 pontos próprios&quot;},{&quot;id&quot;:&quot;pontuar-risco&quot;,&quot;tipo&quot;:&quot;bloco&quot;,&quot;rotulo&quot;:&quot;Pontuação de risco&quot;,&quot;dentro&quot;:&quot;analise&quot;,&quot;nota&quot;:&quot;modelo treinado, roda por veículo&quot;},{&quot;id&quot;:&quot;receber-telemetria&quot;,&quot;tipo&quot;:&quot;bloco&quot;,&quot;rotulo&quot;:&quot;Recepção de telemetria&quot;,&quot;dentro&quot;:&quot;coleta&quot;,&quot;nota&quot;:&quot;aceita lote e tempo real&quot;},{&quot;id&quot;:&quot;veiculo&quot;,&quot;tipo&quot;:&quot;ator&quot;,&quot;rotulo&quot;:&quot;Caminhões&quot;,&quot;nota&quot;:&quot;1.200 veículos, telemetria a cada 30 s&quot;}],&quot;arestas&quot;:[{&quot;de&quot;:&quot;abrir-ordem&quot;,&quot;para&quot;:&quot;avisar-oficina&quot;,&quot;rotulo&quot;:&quot;ordem aberta&quot;},{&quot;de&quot;:&quot;avisar-oficina&quot;,&quot;para&quot;:&quot;oficina&quot;,&quot;rotulo&quot;:&quot;alerta com prazo&quot;},{&quot;de&quot;:&quot;detectar-anomalia&quot;,&quot;para&quot;:&quot;guardar-serie&quot;,&quot;rotulo&quot;:&quot;lê a janela&quot;,&quot;dados&quot;:&quot;volta&quot;},{&quot;de&quot;:&quot;detectar-anomalia&quot;,&quot;para&quot;:&quot;pontuar-risco&quot;,&quot;rotulo&quot;:&quot;anomalia encontrada&quot;},{&quot;de&quot;:&quot;pontuar-risco&quot;,&quot;para&quot;:&quot;abrir-ordem&quot;,&quot;rotulo&quot;:&quot;risco acima do corte&quot;},{&quot;de&quot;:&quot;receber-telemetria&quot;,&quot;para&quot;:&quot;guardar-serie&quot;,&quot;rotulo&quot;:&quot;grava a série&quot;},{&quot;de&quot;:&quot;veiculo&quot;,&quot;para&quot;:&quot;receber-telemetria&quot;,&quot;rotulo&quot;:&quot;envia telemetria&quot;}],&quot;notas&quot;:[{&quot;texto&quot;:&quot;Os três grupos são fronteiras de RESPONSABILIDADE, não contas AWS (#15 §6). Esta vista foi a que a diretoria aprovou.&quot;,&quot;origem&quot;:&quot;premissa&quot;},{&quot;texto&quot;:&quot;Ponto único de recepção conhecido e aceito: um caminho de entrada só, sem par. A frota tolera 30 min de buffer no veículo, e o time aceitou para a fase 1 (2026-08).&quot;,&quot;sobre&quot;:&quot;receber-telemetria&quot;,&quot;origem&quot;:&quot;achado-recusado&quot;}]},&quot;em&quot;:&quot;2026-08-23&quot;,&quot;por&quot;:&quot;diretoria de operações&quot;,&quot;candidata&quot;:&quot;cand-a&quot;}}}">
