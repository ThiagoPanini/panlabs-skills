        <mxCell id="hab-politica" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5A6C86;strokeWidth=1.4;dashed=1;dashPattern=6 4;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="politica" target="balde">
